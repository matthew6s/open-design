---
import Layout from '../../_components/sub-page-layout.astro';
import ModelRankingPair from '../../_components/model-ranking-pair.astro';
import { localeFromPath, localizedHref } from '../../i18n';
import { DOWNLOAD_HREF, OPEN_DESIGN_DISCORD } from '../../cta-actions';
import './model-rankings.css';

const locale = localeFromPath(Astro.url.pathname);
const isZh = locale === 'zh';
const href = (path: string) => localizedHref(path, locale);

const copy = isZh ? {
  title: 'AI 设计模型排行榜 | OpenDesign',
  description: '面向设计任务的独立模型排行榜，所有模型均使用 OpenDesign 同一套私有基准和评分框架进行评测。',
  kicker: 'OpenDesign 模型指数',
  heading: 'AI 设计模型排行榜',
  intro: '使用同一套私有基准与评分框架，比较主流模型在 OpenDesign 中完成真实设计任务的表现。',
  preview: '预览数据',
  previewNote: '正式发布时将替换为完整评测数据，页面结构与指标口径保持不变。',
  overallIndex: '01 / 综合排名',
  leaderboard: '模型排行榜',
  leaderboardDesc: '基于 OpenDesign 评测基准的综合排名。PDR 是主指标，D0、D1 和 D2 用于解释分数构成。',
  metricAria: '排行榜指标',
  metrics: [['pdr', 'PDR', '综合表现'], ['d0', 'D0', '可渲染性'], ['d1', 'D1', '需求实现'], ['d2', 'D2', '设计质量']],
  scoreAria: '评测分数说明',
  primer: [['PDR', '综合结果'], ['D0', '可渲染门槛'], ['D1 · 65', '需求实现度'], ['D2 · 35', '设计质量'], ['EFF', '单独报告']],
  valueFormatAria: '排行榜数值格式', percentage: '百分比', score: '原始分', model: '模型',
  taskIndex: '02 / 分任务最佳', taskHeading: '不同任务的最佳模型', taskDesc: '不只看综合第一，进一步了解每类设计任务中表现最好的模型。', taskLegendAria: '任务类型占比',
  taskGroups: { Visual: '视觉设计', Product: '产品设计', Interface: '界面设计', Data: '数据设计' },
  analysisIndex: '03 / 深入对比', analysisHeading: '探索模型的能力取舍', analysisDesc: '对比分数构成、效率，以及需求实现度与设计质量之间的平衡。',
  analysisAria: '模型分析视图', profile: '分数构成', speed: '速度', cost: '成本', calls: '工具调用', balance: 'D1 × D2',
  difficulty: '任务难度', simple: '简单', general: '一般', difficult: '困难',
  profileEyebrow: '分数构成', profileHeading: '评测结果概览', profileDesc: '对比所有参评模型的 D0 可渲染性、D1 需求实现度与 D2 设计质量。', profileAria: '各模型评测结果',
  lowerBetter: '数值越低越好', pdrVsSpeed: 'PDR × 速度', chartDesc: '左上象限代表设计表现更强、效率更高的模型。', pdrHigher: 'PDR（越高越好 ↑）', runtimeSlower: '运行时间（越右越慢 →）', idealZone: '高 PDR · 高效率', models: '模型',
  requirement: '需求实现度', design: '设计质量', showPareto: '显示帕累托前沿', topModels: '综合表现前 10 的模型', higherBetter: '越高越好 ↗', balancedLeaders: '均衡领先区',
  methodIndex: '04 / 评测方法', methodHeading: '评测框架', methodDesc: '用一个端到端综合分数表达模型表现，并通过三个评测维度解释分数来源。模型效率单独报告。',
  primaryMetric: '主指标', pdrName: '主要设计结果', pdrDesc: '模型在 OpenDesign 评测基准上完成端到端设计任务的归一化综合指数。D0、D1 和 D2 用于解释这一结果的构成。',
  flowAria: '评测流程',
  flow: [['运行', '使用同一套私有任务集和 OpenDesign harness'], ['门槛', 'D0 检查结果是否能正常渲染'], ['评分', 'D1 需求实现 65 分 · D2 设计质量 35 分'], ['报告', 'PDR 排名与单独的效率指标']],
  methods: [
    ['D0', '硬性门槛', 'HTML 可渲染性', '在评估质量前，先确认生成结果能够作为可用网页正常打开。', ['HTML 加载成功', '无空白或被阻断的结果', '无致命运行错误']],
    ['D1', '65 分', '需求实现度', '评估用户要求的产品功能和交互需求是否被真正实现。', ['页面与模块覆盖', '必要内容与界面状态', '交互行为与约束']],
    ['D2', '35 分', '设计质量', '评估最终渲染结果的可见质量、完成度与可用性。', ['信息层级与构图', '排版与视觉完成度', '可读性与响应式表现']],
    ['EFF', '单独报告', '模型效率', '展示模型获得当前结果所需的资源，不会增加或降低 PDR。', ['单次设计任务成本', '工具调用次数', '不同难度任务的总运行时间']],
  ],
  disclosures: [['公平对比', '所有模型均通过同一套 OpenDesign harness、私有基准和评分框架运行。'], ['基准边界', '任务集保持私有，以降低数据污染。排行榜仅公布模型级结果，不公开基准提示词。'], ['如何解读', '分数描述指定版本模型在 OpenDesign 中的表现，不代表通用智能水平排名。']],
  stripLead: '榜单上的每个模型，都能在 OpenDesign 里用你自己的 API Key 直接调用。',
  stripCta: '下载客户端',
  ctaDownload: '下载 OpenDesign',
  ctaDownloadNote: '免费开源 · macOS / Windows',
  ctaDiscord: '加入 Discord',
} : {
  title: 'AI Design Model Rankings | OpenDesign', description: 'Independent model rankings for design work, evaluated with the same private OpenDesign benchmark and scoring framework.', kicker: 'OpenDesign Model Index', heading: 'AI Design Model Rankings', intro: 'One private benchmark and one scoring framework, comparing leading models on real design work in OpenDesign.', preview: 'Preview data', previewNote: 'Final launch scores will replace the demonstration dataset without changing this page structure.', overallIndex: '01 / Overall', leaderboard: 'Model Leaderboard', leaderboardDesc: 'Overall ranking on the OpenDesign benchmark. PDR is the primary score; D0, D1, and D2 explain the result.', metricAria: 'Ranking metric', metrics: [['pdr', 'PDR', 'Overall'], ['d0', 'D0', 'Renderability'], ['d1', 'D1', 'Requirement'], ['d2', 'D2', 'Design quality']], scoreAria: 'How to read the evaluation scores', primer: [['PDR', 'Headline result'], ['D0', 'Renderability gate'], ['D1 · 65', 'Requirement fulfillment'], ['D2 · 35', 'Design quality'], ['EFF', 'Reported separately']], valueFormatAria: 'Leaderboard value format', percentage: 'Percentage', score: 'Score', model: 'Model', taskIndex: '02 / Best by task', taskHeading: 'Top models by task', taskDesc: 'Go beyond the overall winner. See which model leads each design task on OpenDesign.', taskLegendAria: 'Task category share', taskGroups: { Visual: 'Visual', Product: 'Product', Interface: 'Interface', Data: 'Data' }, analysisIndex: '03 / Deep dive', analysisHeading: 'Explore model trade-offs', analysisDesc: 'Compare score composition, efficiency, and the balance between requirement fulfillment and design quality.', analysisAria: 'Model analysis view', profile: 'Score profile', speed: 'Speed', cost: 'Cost', calls: 'Tool calls', balance: 'D1 × D2', difficulty: 'Task difficulty', simple: 'Simple', general: 'General', difficult: 'Difficult', profileEyebrow: 'Score composition', profileHeading: 'Evaluation profile', profileDesc: 'Compare D0 renderability, D1 requirement fulfillment, and D2 design quality across all evaluated models.', profileAria: 'Evaluation profile by model', lowerBetter: 'lower is better', pdrVsSpeed: 'PDR vs Speed', chartDesc: 'Top-left quadrant shows models with stronger design performance and better efficiency.', pdrHigher: 'PDR (higher ↑)', runtimeSlower: 'Runtime (slower →)', idealZone: 'High PDR · High efficiency', models: 'Models', requirement: 'Requirement fulfillment', design: 'Design quality', showPareto: 'Show Pareto', topModels: 'Top 10 evaluated models', higherBetter: 'Higher is better ↗', balancedLeaders: 'Balanced leaders', methodIndex: '04 / Method', methodHeading: 'Evaluation framework', methodDesc: 'One end-to-end performance score, explained by three evaluation dimensions. Efficiency is reported separately.', primaryMetric: 'Primary metric', pdrName: 'Primary Design Result', pdrDesc: "The normalized headline index for a model's end-to-end design performance on the OpenDesign benchmark. D0, D1, and D2 explain where that result comes from.", flowAria: 'Evaluation sequence', flow: [['Run', 'Same private task set and OpenDesign harness'], ['Gate', 'D0 checks whether the result can render'], ['Score', 'D1 requirement, 65 points · D2 design, 35 points'], ['Report', 'PDR ranking plus separate efficiency metrics']], methods: [['D0', 'Hard gate', 'HTML renderability', 'Confirms that the generated result opens as a usable webpage before quality is judged.', ['HTML loads successfully', 'No blank or blocked result', 'No fatal runtime failure']], ['D1', '65 points', 'Requirement fulfillment', 'Measures whether the requested product and interaction requirements are actually implemented.', ['Page and module coverage', 'Required content and states', 'Interactions and constraints']], ['D2', '35 points', 'Design quality', 'Reviews the visible quality and usability of the final rendered experience.', ['Hierarchy and composition', 'Typography and visual finish', 'Readability and responsive behavior']], ['EFF', 'Separate', 'Model efficiency', 'Shows the resources required to reach the result and does not increase or reduce PDR.', ['Cost per design session', 'Tool-call count', 'Total runtime by task difficulty']]], disclosures: [['Fair comparison', 'Models run through the same OpenDesign harness, private benchmark, and scoring framework.'], ['Benchmark boundary', 'Tasks remain private to reduce contamination. The leaderboard publishes model-level results, not benchmark prompts.'], ['How to interpret it', 'Scores describe the evaluated model version in OpenDesign. This is not a general intelligence ranking.']], stripLead: 'Every model on this board runs in OpenDesign with your own API key.', stripCta: 'Download the app', ctaDownload: 'Download OpenDesign', ctaDownloadNote: 'Free & open source · macOS / Windows', ctaDiscord: 'Join the Discord',
};
const methodCards = copy.methods as Array<[string, string, string, string, string[]]>;

type Model = {
  name: string;
  maker: string;
  icon: string;
  color: string;
  badge?: string;
  pdr: number;
  d0: number;
  d1: number;
  d2: number;
  time: number;
  cost: number;
  calls: number;
};

const stealthBadge = isZh ? '隐身' : 'Stealth';
const models: Model[] = [
  { name: 'Claude Opus 5', maker: 'Anthropic', icon: '/agents/anthropic.svg', color: '#ff7c3f', pdr: 89.8, d0: 98.9, d1: 61.2, d2: 32.9, time: 178, cost: 2.31, calls: 17.8 },
  { name: 'Claude Fable 5', maker: 'Anthropic', icon: '/agents/anthropic.svg', color: '#b85c33', pdr: 89.1, d0: 99.1, d1: 60.9, d2: 32.5, time: 151, cost: 1.98, calls: 16.1 },
  { name: 'GPT-5.6 Sol', maker: 'OpenAI', icon: '/agents/openai.svg', color: '#151714', pdr: 88.3, d0: 99.3, d1: 60.6, d2: 31.8, time: 142, cost: 1.84, calls: 15.1 },
  { name: 'Claude Sonnet 5', maker: 'Anthropic', icon: '/agents/anthropic.svg', color: '#df9b70', pdr: 86.5, d0: 98.4, d1: 59.1, d2: 31.4, time: 108, cost: 1.12, calls: 12.8 },
  { name: 'GPT-5.6 Luna', maker: 'OpenAI', icon: '/agents/openai.svg', color: '#66706a', pdr: 84.2, d0: 98.6, d1: 57.9, d2: 30.7, time: 94, cost: .88, calls: 11.4 },
  { name: 'Ox Alpha', maker: isZh ? '匿名实验室' : 'Undisclosed lab', icon: '/agents/ox.svg', color: '#3f463f', badge: stealthBadge, pdr: 83.6, d0: 97.2, d1: 57.4, d2: 30.1, time: 137, cost: 0, calls: 14.2 },
  { name: 'Gemini 3.1 Pro', maker: 'Google', icon: '/agents/gemini.svg', color: '#168cf3', pdr: 81.9, d0: 98.7, d1: 56.2, d2: 29.2, time: 164, cost: 1.92, calls: 16.4 },
  { name: 'Grok 4.6', maker: 'xAI', icon: '/agents/xai.svg', color: '#7a63e8', pdr: 79.8, d0: 96.4, d1: 55.1, d2: 28.7, time: 126, cost: 1.44, calls: 13.1 },
  { name: 'Kimi K3', maker: 'Moonshot AI', icon: '/agents/moonshot.svg', color: '#6350cf', pdr: 78.1, d0: 96.8, d1: 54.3, d2: 28.1, time: 118, cost: .94, calls: 12.9 },
  { name: 'Gemini 3.7 Flash', maker: 'Google', icon: '/agents/gemini.svg', color: '#54bff2', pdr: 76.2, d0: 98.1, d1: 53.4, d2: 27.5, time: 68, cost: .58, calls: 9.4 },
  { name: 'GLM-5.3', maker: 'Z.ai', icon: '/agents/zhipu.svg', color: '#2743d6', pdr: 75.4, d0: 96.1, d1: 53.0, d2: 27.1, time: 97, cost: .57, calls: 11.3 },
  { name: 'Qwen 3.8-Max', maker: 'Alibaba', icon: '/agents/qwen.svg', color: '#564bd0', pdr: 74.3, d0: 95.9, d1: 52.6, d2: 26.9, time: 89, cost: .62, calls: 10.6 },
  { name: 'DeepSeek-V4-Pro', maker: 'DeepSeek', icon: '/agents/deepseek.svg', color: '#5277f6', pdr: 72.4, d0: 94.8, d1: 51.6, d2: 26.4, time: 83, cost: .52, calls: 10.1 },
  { name: 'MiniMax M3', maker: 'MiniMax', icon: '/agents/minimax.svg', color: '#d9418c', pdr: 70.9, d0: 94.2, d1: 50.6, d2: 25.9, time: 91, cost: .47, calls: 10.9 },
  { name: 'Mistral Medium 3.5', maker: 'Mistral AI', icon: '/agents/mistral.svg', color: '#efb02b', pdr: 69.7, d0: 94.6, d1: 49.8, d2: 25.4, time: 76, cost: .44, calls: 9.8 },
  { name: 'Claude Haiku 4.5', maker: 'Anthropic', icon: '/agents/anthropic.svg', color: '#8f7a63', pdr: 68.2, d0: 95.2, d1: 48.9, d2: 24.7, time: 52, cost: .34, calls: 8.4 },
];

const scenarios = [
  { id: 'landing', label: isZh ? '落地页' : 'Landing page', detail: isZh ? '品牌表达与转化路径' : 'Brand expression and conversion', color: '#ef7442' },
  { id: 'dashboard', label: 'Dashboard', detail: isZh ? '信息密度与数据层级' : 'Information density and hierarchy', color: '#6756d8' },
  { id: 'wireframe', label: isZh ? '线框图' : 'Wireframe', detail: isZh ? '结构、层级与信息骨架' : 'Structure, hierarchy and layout', color: '#4f43bb' },
  { id: 'mobile', label: isZh ? '移动端界面' : 'Mobile UI', detail: isZh ? '触控体验与响应式布局' : 'Touch and responsive layout', color: '#319d6a' },
  { id: 'webapp', label: isZh ? 'Web 端 App' : 'Web app', detail: isZh ? '多页面结构与操作流' : 'Multi-page structure and flows', color: '#1589e8' },
];

const clamp = (value: number, min: number, max: number) => Math.max(min, Math.min(max, value));
const scenarioOffset = (scenarioIndex: number, modelIndex: number) => ((scenarioIndex * 11 + modelIndex * 7) % 15) - 7;
const scenarioResults = models.map((model, modelIndex) => ({
  ...model,
  scenarios: scenarios.map((scenario, scenarioIndex) => {
    const offset = scenarioOffset(scenarioIndex, modelIndex);
    const d1 = Number(clamp(model.d1 + offset * .34, 42, 65).toFixed(1));
    const d2 = Number(clamp(model.d2 + offset * .19, 20, 35).toFixed(1));
    const score = Number((d1 + d2).toFixed(1));
    return {
      id: scenario.id,
      d1,
      d2,
      score,
      pdr: Number(clamp(model.pdr + offset * .48, 55, 96).toFixed(1)),
      time: Number((model.time * (1 + scenarioIndex * .08 + Math.max(0, offset) * .008)).toFixed(0)),
      cost: Number((model.cost * (1 + scenarioIndex * .07 + Math.max(0, offset) * .006)).toFixed(2)),
      calls: Number((model.calls * (1 + scenarioIndex * .06 + Math.max(0, offset) * .007)).toFixed(1)),
    };
  }),
}));

const costPlotX = (cost: number) => {
  const minimum = Math.log(.35);
  const maximum = Math.log(3);
  return Number(clamp(8 + ((Math.log(cost) - minimum) / (maximum - minimum)) * 84, 8, 92).toFixed(2));
};
const costPlotY = (pdr: number) => Number(clamp(8 + ((pdr - 60) / 36) * 84, 8, 92).toFixed(2));

const leaderboardGroups = [
  {
    id: 'overall',
    label: isZh ? '综合总榜' : 'Overall',
    detail: isZh ? '所有五个设计场景的综合表现' : 'Combined performance across all five design scenarios',
    rows: scenarioResults.map((model) => ({
      name: model.name, maker: model.maker, icon: model.icon, color: model.color, badge: model.badge,
      score: Number((model.d1 + model.d2).toFixed(1)), pdr: model.pdr, cost: model.cost,
      x: costPlotX(model.cost), y: costPlotY(model.pdr),
    })).sort((a, b) => b.score - a.score),
  },
  ...scenarios.map((scenario, scenarioIndex) => ({
    id: scenario.id,
    label: scenario.label,
    detail: scenario.detail,
    rows: scenarioResults.map((model) => {
      const result = model.scenarios[scenarioIndex]!;
      return {
        name: model.name, maker: model.maker, icon: model.icon, color: model.color, badge: model.badge,
        score: result.score, pdr: result.pdr, cost: result.cost,
        x: costPlotX(result.cost), y: costPlotY(result.pdr),
      };
    }).sort((a, b) => b.score - a.score),
  })),
];

const efficiencyX = (model: Model) => Math.max(5, Math.min(95, 5 + (model.time / 340) * 90));
const efficiencyY = (model: Model) => Math.max(6, Math.min(94, 6 + ((model.pdr - 65) / 25) * 88));

const title = copy.title;
const description = copy.description;
const modelsJson = JSON.stringify(scenarioResults).replace(/</g, '\\u003c');
const scenariosJson = JSON.stringify(scenarios).replace(/</g, '\\u003c');
const clientCopyJson = JSON.stringify({
  percentage: copy.percentage,
  score: copy.score,
  scale: isZh ? '刻度' : 'scale',
  module: {
    speed: { title: isZh ? 'PDR × 速度' : 'PDR vs Speed', xLabel: copy.runtimeSlower, suffix: isZh ? '秒' : 's' },
    cost: { title: isZh ? 'PDR × 成本' : 'PDR vs Cost', xLabel: isZh ? '单次任务成本（越右越高 →）' : 'Cost per session (higher →)' },
    calls: { title: isZh ? 'PDR × 工具调用' : 'PDR vs Tool Calls', xLabel: isZh ? '工具调用次数（越右越多 →）' : 'Tool calls (more →)', suffix: isZh ? '次' : ' calls' },
  },
  scenario: isZh ? '场景' : 'scenario',
  allScenarios: isZh ? '综合' : 'Overall',
  quality: isZh ? '原始分' : 'Score',
  pdr: 'PDR',
  lowerBetter: copy.lowerBetter,
}).replace(/</g, '\\u003c');
---

<Layout
  title={title}
  description={description}
  active="resources"
  mainClassName="model-index-main"
>
  <article class="model-index-page" data-model-index>
    <header class="model-index-intro">
      <p class="model-index-kicker">{copy.kicker}</p>
      <h1>{copy.heading}</h1>
      <p>{copy.intro}</p>
      <div class="model-hero-actions">
        <a class="model-cta-btn model-cta-btn-primary" href={href(DOWNLOAD_HREF)}>
          {copy.ctaDownload}<span class="model-cta-btn-arrow" aria-hidden="true">→</span>
        </a>
        <a class="model-cta-btn" href={OPEN_DESIGN_DISCORD} target="_blank" rel="noopener">{copy.ctaDiscord}</a>
        <span class="model-hero-note">{copy.ctaDownloadNote}</span>
      </div>
      <div class="model-index-note"><span>{copy.preview}</span><p>{copy.previewNote}</p></div>
    </header>

    <section class="model-section leaderboard-section ranking-explorer-section" aria-labelledby="leaderboard-title" data-ranking-explorer>
      <div class="ranking-explorer-layout">
        <aside class="ranking-explorer-sidebar">
          <div class="section-heading">
            <div>
              <h2 id="leaderboard-title">{copy.leaderboard}</h2>
              <p>{copy.leaderboardDesc}</p>
            </div>
          </div>

          <div class="score-primer" aria-label={copy.scoreAria}>
            {copy.primer.map(([code, label], index) => index === copy.primer.length - 1 ? (
              <a href="#analysis-title"><strong>{code}</strong><small>{label}</small></a>
            ) : (
              <span><strong>{code}</strong><small>{label}</small></span>
            ))}
          </div>

          <div class="ranking-explorer-nav-copy">
            <span>{isZh ? '榜单视图' : 'Ranking views'}</span>
            <strong>{isZh ? '综合总榜 + 5 个场景' : 'Overall + five scenarios'}</strong>
            <p>{isZh ? '选择一个场景，在右侧逐一展开完整排名与成本表现。' : 'Choose a scenario to open its full ranking and cost view on the right.'}</p>
          </div>

          <div class="ranking-explorer-tabs" role="tablist" aria-orientation="vertical" aria-label={isZh ? '选择排行榜场景' : 'Choose a ranking scenario'}>
            {leaderboardGroups.map((group, index) => {
              const scene = index === 0 ? null : scenarios[index - 1]!;
              const winner = group.rows[0]!;
              return (
                <button
                  type="button"
                  id={`ranking-tab-${group.id}`}
                  role="tab"
                  aria-selected={index === 0 ? 'true' : 'false'}
                  aria-controls={`scenario-${group.id}`}
                  class:list={['ranking-explorer-tab', { active: index === 0 }]}
                  data-ranking-explorer-tab={group.id}
                  style={`--scenario-color:${scene?.color || 'var(--model-ink)'}`}
                >
                  <span class="ranking-explorer-tab-index">{index === 0 ? (isZh ? '总榜' : 'All') : String(index).padStart(2, '0')}</span>
                  <span class="ranking-explorer-tab-copy"><strong>{group.label}</strong><small>{group.detail}</small><em>{winner.name}</em></span>
                  <span class="ranking-explorer-tab-score"><strong>{winner.score.toFixed(1)}</strong><small>/100</small></span>
                </button>
              );
            })}
          </div>
        </aside>

        <div class="ranking-explorer-panels">
          {leaderboardGroups.map((group, index) => (
            <article
              class:list={['ranking-explorer-panel', { active: index === 0 }]}
              id={`scenario-${group.id}`}
              role="tabpanel"
              aria-labelledby={`ranking-tab-${group.id}`}
              data-ranking-explorer-panel={group.id}
              hidden={index !== 0}
            >
              <header class="ranking-explorer-panel-head">
                <span>{index === 0 ? (isZh ? '总榜' : 'All') : String(index).padStart(2, '0')}</span>
                <div><small>{isZh ? '当前视图' : 'Current view'}</small><h3>{group.label}</h3><p>{group.detail}</p></div>
                <strong>{isZh ? '当前第一' : 'Current leader'}<b>{group.rows[0]!.name}</b></strong>
              </header>
              <ModelRankingPair group={group} isZh={isZh} prominent={index === 0} />
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="model-section analysis-section" aria-labelledby="analysis-title">
      <div class="section-heading">
        <div><h2 id="analysis-title">{isZh ? '效率取舍' : 'Efficiency trade-offs'}</h2><p>{isZh ? '在综合或单个场景中，对照模型原始分与速度、成本、工具调用的关系。' : 'Compare score against speed, cost, and tool calls overall or within a single scene.'}</p></div>
      </div>
      <div class="analysis-explorer" data-analysis>
        <div class="analysis-toolbar">
          <div class="analysis-tabs" role="tablist" aria-label={copy.analysisAria}>
            <button type="button" role="tab" aria-selected="true" aria-controls="analysis-efficiency" class="active" data-analysis-view="speed"><strong>{copy.speed}</strong></button>
            <button type="button" role="tab" aria-selected="false" aria-controls="analysis-efficiency" data-analysis-view="cost"><strong>{copy.cost}</strong></button>
            <button type="button" role="tab" aria-selected="false" aria-controls="analysis-efficiency" data-analysis-view="calls"><strong>{copy.calls}</strong></button>
          </div>
          <div class="efficiency-quality-tabs" role="group" aria-label={isZh ? '纵轴分数' : 'Quality axis'}>
            <button type="button" class="active" aria-pressed="true" data-efficiency-quality="score">{isZh ? '原始分' : 'Score'}</button>
            <button type="button" aria-pressed="false" data-efficiency-quality="pdr">PDR</button>
          </div>
        </div>
        <div class="scenario-filter" role="group" aria-label={isZh ? '选择评测场景' : 'Select evaluation scene'}>
          <button type="button" class="active" aria-pressed="true" data-efficiency-scenario="overall">{isZh ? '综合' : 'Overall'}</button>
          {scenarios.map((scenario) => <button type="button" aria-pressed="false" data-efficiency-scenario={scenario.id}><i style={`background:${scenario.color}`}></i>{scenario.label}</button>)}
        </div>

        <div id="analysis-efficiency" class="analysis-panel" role="tabpanel" data-analysis-panel="efficiency">
          <div class="efficiency-chart-shell">
            <div class="efficiency-chart-main">
              <div class="efficiency-chart-copy"><span data-efficiency-eyebrow>{isZh ? '综合表现 · 数值越低越好' : 'Overall · lower is better'}</span><h3 data-efficiency-title>{isZh ? '原始分 × 速度' : 'Score vs Speed'}</h3><p>{copy.chartDesc}</p></div>
              <div class="efficiency-chart-stage">
                <span class="efficiency-y-title" data-efficiency-y-label>{isZh ? '原始分（越高越好 ↑）' : 'Score (higher ↑)'}</span><span class="efficiency-x-title" data-efficiency-x-label>{copy.runtimeSlower}</span>
                <div class="efficiency-y-ticks" aria-hidden="true" data-efficiency-y-ticks><span>95</span><span>85</span><span>75</span><span>65</span></div>
                <div class="efficiency-x-ticks" aria-hidden="true"><span>0s</span><span>85s</span><span>170s</span><span>255s</span><span>340s</span></div>
                <div class="efficiency-plot">
                  <div class="efficiency-ideal-zone"><span>{isZh ? '高分 · 高效率' : 'High score · High efficiency'}</span></div>
                  <svg class="efficiency-frontier" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true"><polyline points=""></polyline></svg>
                  {scenarioResults.map((model, index) => (
                    <div class:list={['efficiency-point', { 'is-highlighted': index < 4 }]} data-efficiency-point={model.name} style={`left:${efficiencyX(model)}%;bottom:${efficiencyY(model)}%;--point-color:${model.color}`}>
                      <span class="model-icon"><img src={model.icon} alt="" width="28" height="28" /></span>
                      <span class="efficiency-point-label"><strong>{model.name}</strong><small>{model.time}s · {(model.d1 + model.d2).toFixed(1)}</small></span>
                    </div>
                  ))}
                </div>
              </div>
            </div>
            <aside class="efficiency-model-index">
              <div class="model-index-heading"><span>{copy.models}</span><strong data-model-count>{models.length}</strong></div>
              <div class="efficiency-model-list">
                {models.map((model) => (
                  <div class="efficiency-model-row" data-efficiency-row={model.name}>
                    <span class="model-icon"><img src={model.icon} alt="" width="28" height="28" /></span>
                    <span><strong>{model.name}{model.badge ? <em class="model-badge">{model.badge}</em> : null}</strong><small>{model.maker}</small></span><b>{model.time}s</b>
                  </div>
                ))}
              </div>
            </aside>
          </div>
        </div>
      </div>
    </section>

    <section class="model-section compare-section" aria-labelledby="compare-title">
      <div class="section-heading"><div><h2 id="compare-title">{isZh ? '模型对比' : 'Compare models'}</h2><p>{isZh ? '选择二到三个模型，把综合分、三项核心指标与五场景表现放在同一视图中比较。' : 'Select two or three models to compare overall results, core metrics, and all five scenes.'}</p></div></div>
      <div class="compare-picker" role="group" aria-label={isZh ? '选择对比模型' : 'Select models to compare'}>
        {scenarioResults.map((model, index) => <button type="button" class:list={{ active: index < 3 }} aria-pressed={index < 3 ? 'true' : 'false'} data-compare-model={model.name}><span class="model-icon"><img src={model.icon} alt="" width="22" height="22" /></span>{model.name}</button>)}
      </div>
      <div class="compare-grid" data-compare-grid></div>
    </section>

    <section class="model-section method-section" aria-labelledby="method-title">
      <div class="section-heading"><div><h2 id="method-title">{copy.methodHeading}</h2><p>{copy.methodDesc}</p></div></div>
      <div class="method-overview">
        <div class="method-primary"><span>{copy.primaryMetric}</span><div><strong>PDR</strong><h3>{copy.pdrName}</h3></div><p>{copy.pdrDesc}</p></div>
        <ol class="method-flow" aria-label={copy.flowAria}>
          {copy.flow.map(([title, detail]) => <li><span><strong>{title}</strong><small>{detail}</small></span></li>)}
        </ol>
      </div>
      <div class="method-table">
        {methodCards.map(([code, badge, heading, body, bullets]) => (
          <article><header><span>{code}</span><em>{badge}</em></header><h3>{heading}</h3><p>{body}</p><ul>{bullets.map((bullet) => <li>{bullet}</li>)}</ul></article>
        ))}
      </div>
      <div class="method-disclosure">
        {copy.disclosures.map(([heading, body]) => <div><strong>{heading}</strong><p>{body}</p></div>)}
      </div>
    </section>

    <aside class="ranking-strip">
      <p>{copy.stripLead}</p>
      <a href={href(DOWNLOAD_HREF)}>{copy.stripCta}<span aria-hidden="true"> →</span></a>
    </aside>
  </article>
  <script is:inline type="application/json" id="model-rankings-data" set:html={modelsJson}></script>
  <script is:inline type="application/json" id="model-rankings-scenarios" set:html={scenariosJson}></script>
  <script is:inline type="application/json" id="model-rankings-copy" set:html={clientCopyJson}></script>
  <script>
    type EfficiencyModule = 'speed' | 'cost' | 'calls';
    type QualityMetric = 'score' | 'pdr';
    type ScenarioId = 'overall' | string;
    type ScenarioResult = { id: string; d1: number; d2: number; score: number; pdr: number; time: number; cost: number; calls: number };
    type ClientModel = {
      name: string;
      maker: string;
      icon: string;
      color: string;
      badge?: string;
      pdr: number;
      d0: number;
      d1: number;
      d2: number;
      time: number;
      cost: number;
      calls: number;
      scenarios: ScenarioResult[];
    };
    type ClientScenario = { id: string; label: string; color: string };
    type ClientCopy = {
      percentage: string;
      score: string;
      scale: string;
      module: Record<EfficiencyModule, { title: string; xLabel: string; suffix?: string }>;
      scenario: string;
      allScenarios: string;
      quality: string;
      pdr: string;
      lowerBetter: string;
    };

    const root = document.querySelector<HTMLElement>('[data-model-index]');
    const dataElement = document.querySelector<HTMLScriptElement>('#model-rankings-data');
    const scenariosElement = document.querySelector<HTMLScriptElement>('#model-rankings-scenarios');
    const copyElement = document.querySelector<HTMLScriptElement>('#model-rankings-copy');
    if (root && dataElement && scenariosElement && copyElement) {
      const modelData = JSON.parse(dataElement.textContent || '[]') as ClientModel[];
      const scenarioData = JSON.parse(scenariosElement.textContent || '[]') as ClientScenario[];
      const clientCopy = JSON.parse(copyElement.textContent || '{}') as ClientCopy;
      root.querySelectorAll<HTMLElement>('[data-ranking-card]').forEach((card) => {
        const list = card.querySelector<HTMLElement>('.ranking-list');
        const label = card.querySelector<HTMLElement>('[data-ranking-value-label]');
        const buttons = [...card.querySelectorAll<HTMLButtonElement>('[data-ranking-view]')];
        const render = (view: 'score' | 'percentage') => {
          const rows = [...card.querySelectorAll<HTMLElement>('[data-ranking-row]')].sort((a, b) => Number(b.dataset[view] || 0) - Number(a.dataset[view] || 0));
          rows.forEach((row, index) => {
            const value = Number(row.dataset[view] || 0);
            const height = Math.max(12, Math.min(84, (value - 50) * 1.7));
            const position = row.querySelector<HTMLElement>('[data-ranking-position]');
            const valueNode = row.querySelector<HTMLElement>('.ranking-value');
            if (position) position.textContent = String(index + 1);
            row.style.setProperty('--model-value', String(value));
            row.style.setProperty('--model-height', `${height}%`);
            if (valueNode) valueNode.innerHTML = view === 'percentage' ? `<strong>${value.toFixed(1)}%</strong><small></small>` : `<strong>${value.toFixed(1)}</strong><small>/100</small>`;
            list?.append(row);
          });
          if (label) label.textContent = view === 'percentage' ? clientCopy.percentage : clientCopy.score;
          buttons.forEach((button) => {
            const selected = button.dataset.rankingView === view;
            button.classList.toggle('active', selected);
            button.setAttribute('aria-selected', String(selected));
          });
        };
        buttons.forEach((button) => button.addEventListener('click', () => render(button.dataset.rankingView as 'score' | 'percentage')));
        render('score');
      });

      // 常驻标签的方向：构建期只能按百分比估算，误差够大到会撞。
      // 这里用真实几何重算一次，按名次依次放，每个都避开其它模型的点和已放好的标签。
      const overlap = (a: DOMRect, b: DOMRect) => a.right > b.left && a.left < b.right && a.bottom > b.top && a.top < b.bottom;
      const positionCostLabels = (scope: ParentNode) => {
        scope.querySelectorAll<HTMLElement>('.cost-plot').forEach((plot) => {
          const points = [...plot.querySelectorAll<HTMLElement>('.cost-point')];
          const placed: DOMRect[] = [];
          points.filter((point) => point.classList.contains('is-labeled')).forEach((point) => {
            const label = point.querySelector<HTMLElement>('.cost-point-label');
            if (!label) return;
            const bounds = plot.getBoundingClientRect();
            let best: { dir: string; cost: number } | null = null;
            for (const dir of ['up', 'down', 'up-right', 'up-left', 'down-right', 'down-left', 'right', 'left']) {
              point.dataset.labelDir = dir;
              const rect = label.getBoundingClientRect();
              let cost = rect.left < bounds.left - 62 || rect.right > bounds.right + 62 || rect.top < bounds.top - 32 || rect.bottom > bounds.bottom + 32 ? 3 : 0;
              points.forEach((other) => { if (other !== point && overlap(rect, other.getBoundingClientRect())) cost += 1; });
              placed.forEach((rows) => { if (overlap(rect, rows)) cost += 2; });
              if (!best || cost < best.cost) best = { dir, cost };
              if (cost === 0) break;
            }
            // 放不下就不放：第 1 名保底常驻，2、3 名只在能干净落位时才常驻，
            // 否则退回 hover 显示 —— 密集的图里宁可少两个标签，也不要压字。
            if (best!.cost > 0 && placed.length > 0) {
              point.classList.remove('is-labeled');
              delete point.dataset.labelDir;
              return;
            }
            point.dataset.labelDir = best!.dir;
            placed.push(label.getBoundingClientRect());
          });
        });
      };

      const explorerTabs = [...root.querySelectorAll<HTMLButtonElement>('[data-ranking-explorer-tab]')];
      const explorerPanels = [...root.querySelectorAll<HTMLElement>('[data-ranking-explorer-panel]')];
      const explorerTablist = root.querySelector<HTMLElement>('.ranking-explorer-tabs');
      const explorerNarrowLayout = window.matchMedia('(max-width: 1180px)');
      const syncExplorerOrientation = () => explorerTablist?.setAttribute('aria-orientation', explorerNarrowLayout.matches ? 'horizontal' : 'vertical');
      syncExplorerOrientation();
      explorerNarrowLayout.addEventListener('change', syncExplorerOrientation);
      const activateRankingPanel = (id: string, moveFocus = false, updateHash = false) => {
        const selectedTab = explorerTabs.find((tab) => tab.dataset.rankingExplorerTab === id) || explorerTabs[0];
        if (!selectedTab) return;
        const selectedId = selectedTab.dataset.rankingExplorerTab || 'overall';
        explorerTabs.forEach((tab) => {
          const selected = tab === selectedTab;
          tab.classList.toggle('active', selected);
          tab.setAttribute('aria-selected', String(selected));
          tab.tabIndex = selected ? 0 : -1;
        });
        explorerPanels.forEach((panel) => {
          const selected = panel.dataset.rankingExplorerPanel === selectedId;
          panel.classList.toggle('active', selected);
          panel.hidden = !selected;
          if (selected) requestAnimationFrame(() => positionCostLabels(panel));
        });
        if (moveFocus) selectedTab.focus();
        if (updateHash) {
          const hash = selectedId === 'overall' ? '#leaderboard-title' : `#scenario-${selectedId}`;
          history.replaceState(null, '', hash);
        }
      };
      explorerTabs.forEach((tab, index) => {
        tab.addEventListener('click', () => activateRankingPanel(tab.dataset.rankingExplorerTab || 'overall', false, true));
        tab.addEventListener('keydown', (event) => {
          const forwardKey = explorerNarrowLayout.matches ? 'ArrowRight' : 'ArrowDown';
          const backwardKey = explorerNarrowLayout.matches ? 'ArrowLeft' : 'ArrowUp';
          if (![forwardKey, backwardKey, 'Home', 'End'].includes(event.key)) return;
          event.preventDefault();
          let nextIndex = index;
          if (event.key === 'Home') nextIndex = 0;
          else if (event.key === 'End') nextIndex = explorerTabs.length - 1;
          else if (event.key === forwardKey) nextIndex = (index + 1) % explorerTabs.length;
          else nextIndex = (index - 1 + explorerTabs.length) % explorerTabs.length;
          const nextTab = explorerTabs[nextIndex];
          if (nextTab) activateRankingPanel(nextTab.dataset.rankingExplorerTab || 'overall', true, true);
        });
      });
      const initialScenario = window.location.hash.startsWith('#scenario-') ? window.location.hash.slice('#scenario-'.length) : 'overall';
      activateRankingPanel(initialScenario);
      window.addEventListener('hashchange', () => {
        if (window.location.hash === '#leaderboard-title') activateRankingPanel('overall');
        else if (window.location.hash.startsWith('#scenario-')) activateRankingPanel(window.location.hash.slice('#scenario-'.length));
      });

      const moduleConfig = {
        speed: { label: clientCopy.module.speed.title.replace('PDR', ''), xLabel: clientCopy.module.speed.xLabel, maximum: 340, ticks: [0, 85, 170, 255, 340], format: (value: number) => `${Math.round(value)}${clientCopy.module.speed.suffix}` },
        cost: { label: clientCopy.module.cost.title.replace('PDR', ''), xLabel: clientCopy.module.cost.xLabel, maximum: 4.8, ticks: [0, 1.2, 2.4, 3.6, 4.8], format: (value: number) => `$${value.toFixed(2)}` },
        calls: { label: clientCopy.module.calls.title.replace('PDR', ''), xLabel: clientCopy.module.calls.xLabel, maximum: 32, ticks: [0, 8, 16, 24, 32], format: (value: number) => `${value.toFixed(1)}${clientCopy.module.calls.suffix}` },
      } satisfies Record<EfficiencyModule, { label: string; xLabel: string; maximum: number; ticks: number[]; format: (value: number) => string }>;
      let activeModule: EfficiencyModule = 'speed';
      let activeScenario: ScenarioId = 'overall';
      let activeQuality: QualityMetric = 'score';

      const resultFor = (model: ClientModel) => activeScenario === 'overall' ? model : model.scenarios.find((result) => result.id === activeScenario) || model;
      const qualityFor = (model: ClientModel) => {
        const result = resultFor(model) as ClientModel | ScenarioResult;
        return activeQuality === 'pdr' ? result.pdr : ('score' in result ? result.score : result.d1 + result.d2);
      };
      const valueFor = (model: ClientModel) => {
        const result = resultFor(model) as ClientModel | ScenarioResult;
        if (activeModule === 'speed') return result.time;
        if (activeModule === 'cost') return result.cost;
        return result.calls;
      };
      const renderEfficiency = () => {
        const config = moduleConfig[activeModule];
        const scene = activeScenario === 'overall' ? clientCopy.allScenarios : scenarioData.find((item) => item.id === activeScenario)?.label || activeScenario;
        const qualityLabel = activeQuality === 'score' ? clientCopy.quality : clientCopy.pdr;
        const eyebrow = root.querySelector<HTMLElement>('[data-efficiency-eyebrow]');
        const titleNode = root.querySelector<HTMLElement>('[data-efficiency-title]');
        const yLabel = root.querySelector<HTMLElement>('[data-efficiency-y-label]');
        const xLabel = root.querySelector<HTMLElement>('[data-efficiency-x-label]');
        const xTicks = root.querySelector<HTMLElement>('.efficiency-x-ticks');
        const yTicks = root.querySelector<HTMLElement>('[data-efficiency-y-ticks]');
        if (eyebrow) eyebrow.textContent = `${scene} · ${clientCopy.lowerBetter}`;
        if (titleNode) titleNode.textContent = `${qualityLabel} × ${config.label.replace(/^[ ×]+|[ ×]+$/g, '')}`;
        if (yLabel) yLabel.textContent = `${qualityLabel} (${activeQuality === 'pdr' ? '%' : '/100'})`;
        if (xLabel) xLabel.textContent = config.xLabel;
        if (xTicks) xTicks.innerHTML = config.ticks.map((tick) => `<span>${config.format(tick)}</span>`).join('');
        if (yTicks) yTicks.innerHTML = (activeQuality === 'pdr' ? [95, 85, 75, 65] : [96, 86, 76, 66]).map((tick) => `<span>${tick}</span>`).join('');
        const points = modelData.map((model) => {
          const value = valueFor(model);
          const quality = qualityFor(model);
          return { model, value, quality, x: Math.max(5, Math.min(95, 5 + value / config.maximum * 90)), y: Math.max(6, Math.min(94, 6 + (quality - 62) / 35 * 88)) };
        });
        points.forEach(({ model, value, quality, x, y }) => {
          const point = root.querySelector<HTMLElement>(`[data-efficiency-point="${CSS.escape(model.name)}"]`);
          const row = root.querySelector<HTMLElement>(`[data-efficiency-row="${CSS.escape(model.name)}"]`);
          if (point) {
            point.style.left = `${x}%`;
            point.style.bottom = `${y}%`;
            const label = point.querySelector<HTMLElement>('small');
            if (label) label.textContent = `${config.format(value)} · ${quality.toFixed(1)}${activeQuality === 'pdr' ? '%' : ''}`;
          }
          const rowValue = row?.querySelector<HTMLElement>('b');
          if (rowValue) rowValue.textContent = config.format(value);
        });
        let best = -Infinity;
        const frontier = [...points].sort((a, b) => a.value - b.value).filter((point) => {
          if (point.quality <= best) return false;
          best = point.quality;
          return true;
        });
        const polyline = root.querySelector<SVGPolylineElement>('.efficiency-frontier polyline');
        if (polyline) polyline.setAttribute('points', frontier.map((point) => `${point.x},${100 - point.y}`).join(' '));
      };

      root.querySelectorAll<HTMLButtonElement>('[data-analysis-view]').forEach((button) => button.addEventListener('click', () => {
        activeModule = button.dataset.analysisView as EfficiencyModule;
        root.querySelectorAll<HTMLButtonElement>('[data-analysis-view]').forEach((item) => {
          const selected = item === button;
          item.classList.toggle('active', selected);
          item.setAttribute('aria-selected', String(selected));
        });
        renderEfficiency();
      }));
      root.querySelectorAll<HTMLButtonElement>('[data-efficiency-scenario]').forEach((button) => button.addEventListener('click', () => {
        activeScenario = button.dataset.efficiencyScenario || 'overall';
        root.querySelectorAll<HTMLButtonElement>('[data-efficiency-scenario]').forEach((item) => {
          const selected = item === button;
          item.classList.toggle('active', selected);
          item.setAttribute('aria-pressed', String(selected));
        });
        renderEfficiency();
      }));
      root.querySelectorAll<HTMLButtonElement>('[data-efficiency-quality]').forEach((button) => button.addEventListener('click', () => {
        activeQuality = button.dataset.efficiencyQuality as QualityMetric;
        root.querySelectorAll<HTMLButtonElement>('[data-efficiency-quality]').forEach((item) => {
          const selected = item === button;
          item.classList.toggle('active', selected);
          item.setAttribute('aria-pressed', String(selected));
        });
        renderEfficiency();
      }));

      let comparedModels = modelData.slice(0, 3).map((model) => model.name);
      const renderCompare = () => {
        const grid = root.querySelector<HTMLElement>('[data-compare-grid]');
        if (!grid) return;
        grid.innerHTML = comparedModels.map((name) => {
          const model = modelData.find((item) => item.name === name)!;
          const sceneRows = model.scenarios.map((result) => {
            const scenario = scenarioData.find((item) => item.id === result.id)!;
            return `<div><span><i style="background:${scenario.color}"></i>${scenario.label}</span><b>${result.score.toFixed(1)}</b></div>`;
          }).join('');
          return `<article class="compare-card" style="--compare-color:${model.color}">
            <header><span class="model-icon"><img src="${model.icon}" alt="" width="28" height="28"></span><span><strong>${model.name}${model.badge ? `<em class="model-badge">${model.badge}</em>` : ''}</strong><small>${model.maker}</small></span></header>
            <div class="compare-headline"><span>PDR <strong>${model.pdr.toFixed(1)}%</strong></span><span>${clientCopy.quality} <strong>${(model.d1 + model.d2).toFixed(1)}</strong></span></div>
            <div class="compare-metrics"><div><small>D1</small><strong>${model.d1.toFixed(1)}<i>/65</i></strong></div><div><small>D2</small><strong>${model.d2.toFixed(1)}<i>/35</i></strong></div><div><small>Speed</small><strong>${model.time}s</strong></div><div><small>Cost</small><strong>$${model.cost.toFixed(2)}</strong></div><div><small>Calls</small><strong>${model.calls.toFixed(1)}</strong></div></div>
            <div class="compare-scenes">${sceneRows}</div>
          </article>`;
        }).join('');
        root.querySelectorAll<HTMLButtonElement>('[data-compare-model]').forEach((button) => {
          const selected = comparedModels.includes(button.dataset.compareModel || '');
          button.classList.toggle('active', selected);
          button.setAttribute('aria-pressed', String(selected));
        });
      };
      root.querySelectorAll<HTMLButtonElement>('[data-compare-model]').forEach((button) => button.addEventListener('click', () => {
        const name = button.dataset.compareModel || '';
        if (comparedModels.includes(name)) {
          if (comparedModels.length > 2) comparedModels = comparedModels.filter((item) => item !== name);
        } else if (comparedModels.length < 3) {
          comparedModels = [...comparedModels, name];
        } else {
          comparedModels = [...comparedModels.slice(1), name];
        }
        renderCompare();
      }));

      renderEfficiency();
      renderCompare();
    }
  </script>
</Layout>
