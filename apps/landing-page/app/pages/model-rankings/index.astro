  MODEL_RANKING_SCENARIOS,
  RANKED_MODELS,
  EXCLUDED_MODELS,
  type RankedModel,
  type ScenarioId,
} from '../../data/model-rankings-data';
import './model-rankings.css';

const locale = localeFromPath(Astro.url.pathname);
const isZh = locale === 'zh';
const href = (path: string) => localizedHref(path, locale);

const copy = isZh ? {
