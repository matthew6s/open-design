  analysisAria: '模型效率指标', profile: '分数构成', ttft: '首次响应', duration: '完成耗时', cacheHit: '缓存命中率', inputTokens: '输入 Token', outputTokens: '输出 Token', balance: 'D1 × D2',
  difficulty: '任务难度', simple: '简单', general: '一般', difficult: '困难',
  profileEyebrow: '分数构成', profileHeading: '评测结果概览', profileDesc: '对比所有参评模型的 D0 可渲染性、D1 需求实现度与 D2 设计质量。', profileAria: '各模型评测结果',
  lowerBetter: '数值越低越好', pdrVsSpeed: '总分 × 速度', chartDesc: '左上象限代表设计表现更强、效率更高的模型。', pdrHigher: '总分（越高越好 ↑）', runtimeSlower: '运行时间（越右越慢 →）', idealZone: '高总分 · 高效率', models: '模型',
  requirement: '需求实现度', design: '设计质量', showPareto: '显示帕累托前沿', topModels: '综合表现前 10 的模型', higherBetter: '越高越好 ↗', balancedLeaders: '均衡领先区',
  methodIndex: '04 / 评测方法', methodHeading: '评测框架', methodDesc: '用一个端到端综合分数表达模型表现，并通过三个评测维度解释分数来源。模型效率单独报告。',
  primaryMetric: '主指标', pdrName: '总分与可交付率', pdrDesc: '总分 = D1 + D2，满分 100，是模型在 OpenDesign 基准上完成端到端设计任务的直接得分。可交付率是总分达到 80 的产物占比，回答的是「这个模型多大概率一次就给出一个能用的稿」。',
  flowAria: '评测流程',
  flow: [['运行', '同一套私有任务集、同一条 OpenDesign 执行链路，每题跑两轮'], ['门槛', 'D0 检查产物能否正常打开'], ['评分', '11 位设计师逐条打分：D1 需求实现 30 分 · D2 设计质量 70 分'], ['通过', '总分不低于 80 即视为可直接交付'], ['报告', '总分排名，效率与成本单独列出']],
  methods: [
    ['D0', '硬性门槛', '产物可渲染性', '评分前先确认产物能作为可用网页打开。打不开的产物按 0 分计入统计，不做补测。', ['页面可正常打开', '无空白或被阻断的结果', '无致命运行错误']],
    ['D1', '30 分', '需求实现度', '按每道题 6 到 9 条功能核对项逐条判定，每条评为达成、部分达成或未达成（1、0.5、0）。', ['页面与模块覆盖', '必要内容与界面状态', '交互行为与约束']],
    ['D2', '70 分', '设计质量', '五个维度分别评为 Pass、Partial 或 Fail（1、0.5、0），D2 = 70 ×（五个维度得分之和 ÷ 5）。', ['布局与可读性', '信息层级', '风格与任务一致性', '颜色、对比与主题', '图片适配与内容相关性']],
    ['EFF', '单独报告', '模型效率与成本', '展示模型拿到这个结果花了多少资源，不影响总分。成本按各家官网标价乘实测 token 用量计算。', ['TTFT 与完成耗时', '缓存命中率与工具调用次数', '输入输出 Token 与单次成本']],
  ],
  disclosures: [['公平对比', '所有模型跑同一套私有任务集和同一条 OpenDesign 执行链路，由同一批设计师按同一套标准打分。同一道题的所有模型由同一位评审评判，横向对比不受个人宽严影响。'], ['样本量与误差', '每个模型 30 个产物，均分的 95% 置信区间在 ±5 到 ±11 分之间。相差 10 分以内的名次，这批数据分不出高下。本轮每个产物只有一位评审，评审间一致性尚未校准。'], ['基准边界', '任务集保持私有以降低数据污染，只公布模型级结果，不公开题目提示词。'], ['如何解读', '分数描述指定版本模型在 OpenDesign 原型生成任务上的表现，不代表通用智能水平排名。']],
  stripLead: '在 OpenDesign 中使用自己的 API Key 调用榜单模型。',
  stripCta: '下载客户端',
  ctaDownload: '下载 OpenDesign',
  ctaDiscord: '加入 Discord',
} : {
  title: 'OpenDesign Arena | OpenDesign', description: 'An AI model benchmark for frontend design. Every model is evaluated with the same private OpenDesign benchmark and scoring framework.', heading: 'OpenDesign Arena', intro: 'Compare leading models on the same real design tasks across requirement fulfillment, design quality, and model efficiency, with results organized by frontend design use case.', findings: [['Slower and more expensive does not mean better', 'Duration correlates with score at -0.005 and tokens at -0.151. Effectively zero.'], ['Cost varies by two orders of magnitude more than quality', 'Cost per artifact runs from $0.035 to $7.66, a 219x spread, while those two ends differ by 8.7 points.'], ['Points are lost on design, not on features', 'Feature checklists score 83.6%; the five design dimensions only 68.1%. The modules are there — they just do not look good.'], ['Half of all artifacts are not ready to hand off', '49.4% of 421 artifacts reached 80. For multi-page web apps it is only 35.3%.']], overallIndex: '01 / Overall', leaderboard: 'Overall model performance', leaderboardDesc: 'Aggregated results across five design scenarios, comparing total score, delivery rate, and cost per run. 30 artifacts per model; the plus-minus figure is the 95% confidence interval of the mean.', metricAria: 'Ranking metric', metrics: [['pdr', 'Delivery rate', 'Share scoring 80+'], ['d0', 'D0', 'Renderability'], ['d1', 'D1', 'Requirement'], ['d2', 'D2', 'Design quality']], scoreAria: 'How to read the evaluation scores', primer: [['Score · 100', 'D1 + D2'], ['Delivery rate', 'Share scoring 80+'], ['D0', 'Renderability gate'], ['D1 · 30', 'Requirement fulfillment'], ['D2 · 70', 'Design quality']], valueFormatAria: 'Leaderboard value format', percentage: 'Delivery rate', score: 'Score', model: 'Model', taskIndex: '02 / Task performance', taskHeading: 'Performance by task', taskDesc: 'Five scenarios, three tasks each, two runs per task. A single model has only 6 artifacts per scenario, so per-scenario figures are indicative rather than a ranking.', taskLegendAria: 'Task category share', taskGroups: { Visual: 'Visual', Product: 'Product', Interface: 'Interface', Data: 'Data' }, analysisIndex: '03 / Model efficiency', analysisHeading: 'Model efficiency', analysisDesc: 'Compare first response, completion time, cache hit rate, and token consumption. All figures are measured medians.', analysisAria: 'Model efficiency metric', profile: 'Score profile', ttft: 'First response', duration: 'Completion time', cacheHit: 'Cache hit rate', inputTokens: 'Input tokens', outputTokens: 'Output tokens', balance: 'D1 × D2', difficulty: 'Task difficulty', simple: 'Simple', general: 'General', difficult: 'Difficult', profileEyebrow: 'Score composition', profileHeading: 'Evaluation profile', profileDesc: 'Compare D0 renderability, D1 requirement fulfillment, and D2 design quality across all evaluated models.', profileAria: 'Evaluation profile by model', lowerBetter: 'lower is better', pdrVsSpeed: 'Score vs speed', chartDesc: 'The highlighted quadrant shows models that preserve quality while using resources more efficiently.', pdrHigher: 'Score (higher ↑)', runtimeSlower: 'Runtime (slower →)', idealZone: 'High score · High efficiency', models: 'Models', requirement: 'Requirement fulfillment', design: 'Design quality', showPareto: 'Show Pareto', topModels: 'Top 10 evaluated models', higherBetter: 'Higher is better ↗', balancedLeaders: 'Balanced leaders', methodIndex: '04 / Method', methodHeading: 'Evaluation framework', methodDesc: 'One end-to-end performance score, explained by three evaluation dimensions. Efficiency is reported separately.', primaryMetric: 'Primary metric', pdrName: 'Total score and delivery rate', pdrDesc: "Total score is D1 plus D2 out of 100, a model's direct result on the OpenDesign benchmark. Delivery rate is the share of artifacts reaching 80, answering how often a model hands you something usable on the first try.", flowAria: 'Evaluation sequence', flow: [['Run', 'Same private task set, same OpenDesign execution path, two runs per task'], ['Gate', 'D0 checks whether the artifact opens at all'], ['Score', '11 designers score every artifact: D1 requirement 30 points, D2 design 70 points'], ['Pass', 'A total of 80 or above counts as ready to hand off'], ['Report', 'Ranked by total score, with efficiency and cost reported separately']], methods: [['D0', 'Hard gate', 'Artifact renderability', 'Confirms the artifact opens as a usable webpage before quality is judged. Artifacts that fail score zero and stay in the statistics rather than being re-run.', ['Page opens successfully', 'No blank or blocked result', 'No fatal runtime failure']], ['D1', '30 points', 'Requirement fulfillment', 'Six to nine checklist items per task, each rated met, partly met, or not met (1, 0.5, 0).', ['Page and module coverage', 'Required content and states', 'Interactions and constraints']], ['D2', '70 points', 'Design quality', 'Each of five dimensions is rated Pass, Partial, or Fail (1, 0.5, or 0). D2 = 70 × (sum of five dimension scores ÷ 5).', ['Layout and readability', 'Information hierarchy', 'Style-task alignment', 'Color, contrast, and theme', 'Image fit and content relevance']], ['EFF', 'Separate', 'Efficiency and cost', 'Shows the resources a model spent reaching this result. It does not affect the total score. Cost is list price multiplied by measured token usage.', ['TTFT and completion time', 'Cache hit rate and tool calls', 'Input/output tokens and cost per run']]], disclosures: [['Fair comparison', 'Every model runs the same private task set through the same OpenDesign execution path, scored by the same designers against the same rubric. All models on a given task are judged by the same reviewer, so head-to-head comparison is not skewed by individual strictness.'], ['Sample size and error', '30 artifacts per model; the 95% confidence interval of the mean runs from plus-minus 5 to plus-minus 11 points. Gaps under 10 points are not separable in this dataset. Each artifact was scored by a single reviewer this round, so inter-rater agreement is not yet calibrated.'], ['Benchmark boundary', 'Tasks stay private to reduce contamination. Only model-level results are published, not the prompts.'], ['How to interpret it', 'Scores describe the evaluated model version on OpenDesign prototype generation. This is not a general intelligence ranking.']], stripLead: 'Use your own API key to run ranked models in OpenDesign.', stripCta: 'Download the app', ctaDownload: 'Download OpenDesign', ctaDiscord: 'Join the Discord',
};

const decisionCopy = isZh ? {
  heading: '按使用场景选模型',
  description: '按设计场景和关注指标筛选，对比综合表现、成本效率与响应速度。',
  scenarioLabel: '设计场景',
  priorityLabel: '关注指标',
  overall: '全部场景',
  priorities: [['overall', '综合效果'], ['design', '设计质量'], ['requirement', '需求完成度'], ['speed', '响应速度'], ['cost', '使用成本']],
  roleLabels: { overall: '综合表现', design: '设计质量', requirement: '需求完成度', cost: '成本效率', speed: '响应速度' },
  radar: {
    aria: '推荐模型五维相对表现', current: '当前模型', median: '场景中位数', unavailable: '未披露',
    axes: ['需求完成度', '设计质量', '成本效率', '完成速度', '首次响应'],
  },
  overallSignals: ['综合表现', '成本效率', '响应速度'],
  scenarioHeading: '分场景排名',
  scenarioDescription: '查看五类设计场景中的模型总分、可交付率与单份成本。每个模型在单场景只有 6 个产物，误差较大，仅供参考。',
  sceneChoice: '场景领先模型',
} : {
  heading: 'Choose by use case',
  description: 'Filter by design scenario and priority to compare overall performance, cost efficiency, and response speed.',
  scenarioLabel: 'Design scenario',
  priorityLabel: 'Priority',
  overall: 'All scenarios',
  priorities: [['overall', 'Overall result'], ['design', 'Design quality'], ['requirement', 'Requirement fulfillment'], ['speed', 'Response speed'], ['cost', 'Usage cost']],
  roleLabels: { overall: 'Overall performance', design: 'Design quality', requirement: 'Requirement fulfillment', cost: 'Cost efficiency', speed: 'Response speed' },
  radar: {
    aria: 'Five-dimension relative profile for the recommended model', current: 'Current model', median: 'Scenario median', unavailable: 'Not disclosed',
    axes: ['Requirement', 'Design quality', 'Cost efficiency', 'Completion speed', 'First response'],
  },
  overallSignals: ['Overall performance', 'Cost efficiency', 'Response speed'],
  scenarioHeading: 'Rankings by scenario',
  scenarioDescription: 'Compare total score, delivery rate, and cost per artifact across five design scenarios. Only 6 artifacts per model per scenario, so treat these as indicative.',
  sceneChoice: 'Scenario leader',
};
const methodCards = copy.methods as Array<[string, string, string, string, string[]]>;

type Model = {
  name: string;
  maker: string;
  icon: string;
  color: string;
  badge?: string;
  /** 实测总分，等于 D1 + D2，但取自原始明细的平均而非四舍五入后相加 */
  score: number;
  pdr: number;
  d0: number;
  d1: number;
  d2: number;
  ttft: number;
  time: number;
  cacheHit: number;
  inputTokens: number;
  outputTokens: number;
  cost: number;
  calls: number;
};

const clamp = (value: number, min: number, max: number) => Math.max(min, Math.min(max, value));

/**
 * 榜单只展示进入排名的模型；本轮执行异常的模型通过 EXCLUDED_MODELS 单独披露，
 * 不参与任何排序、推荐或图表。
 */
const rankedModels = RANKED_MODELS;
const excludedModels = EXCLUDED_MODELS;

const toModel = (model: RankedModel): Model => ({
  name: model.name,
  maker: model.maker,
  icon: model.icon,
  color: model.color,
  score: model.score,
  pdr: model.pdr,
  d0: model.d0,
  d1: model.d1,
  d2: model.d2,
  ttft: model.ttft,
  time: model.time,
  cacheHit: model.cacheHit,
  inputTokens: model.inputTokens,
  outputTokens: model.outputTokens,
  cost: model.cost,
  calls: model.calls,
});

const models: Model[] = rankedModels.map(toModel);

const scenarios = MODEL_RANKING_SCENARIOS.map((scenario, index) => ({
  id: scenario.id,
  label: scenario.label[isZh ? 'zh' : 'en'],
  detail: scenario.detail[isZh ? 'zh' : 'en'],
  fit: isZh
    ? `${scenario.cases} 道题 · ${scenario.n} 个产物 · 可交付率 ${scenario.pdr}%`
    : `${scenario.cases} tasks · ${scenario.n} artifacts · ${scenario.pdr}% delivery rate`,
  color: ['#ef7442', '#6756d8', '#4f43bb', '#319d6a', '#1589e8'][index] ?? '#6756d8',
  area: ['1 / 1 / 3 / 4', '1 / 4 / 2 / 7', '2 / 4 / 3 / 7', '1 / 7 / 3 / 9', '1 / 9 / 3 / 11'][index] ?? 'auto',
  score: scenario.score,
  pdr: scenario.pdr,
  cases: scenario.cases,
  sampleSize: scenario.n,
}));

/** 每个模型在每个场景 / 每档难度下的实测成绩，直接来自评测数据，不做任何推导。 */
const scenarioResults = rankedModels.map((model) => ({
  ...toModel(model),
  difficulty: model.difficulty,
  scenarios: MODEL_RANKING_SCENARIOS.map((scenario) => {
    const slice = model.scenarios[scenario.id as ScenarioId];
    return { id: scenario.id, ...slice };
  }),
}));

// 实测单份成本跨度超过 200 倍（$0.035 – $7.66），横轴必须取对数才排得开。
const COST_AXIS_MIN = .02;
const COST_AXIS_MAX = 10;
const costPlotX = (cost: number) => {
  const minimum = Math.log(COST_AXIS_MIN);
  const maximum = Math.log(COST_AXIS_MAX);
  return Number(clamp(8 + ((Math.log(Math.max(cost, COST_AXIS_MIN)) - minimum) / (maximum - minimum)) * 84, 8, 92).toFixed(2));
};
// 纵轴用总分（实测 65.7 – 79.8），留出 60 – 85 的余量。
const costPlotY = (score: number) => Number(clamp(8 + ((score - 60) / 25) * 84, 8, 92).toFixed(2));

const leaderboardGroups = [
  {
    id: 'overall',
    label: isZh ? '综合总榜' : 'Overall',
    detail: isZh ? '所有五个设计场景的综合表现' : 'Combined performance across all five design scenarios',
    rows: scenarioResults.map((model) => ({
      name: model.name, maker: model.maker, icon: model.icon, color: model.color, badge: model.badge,
      score: model.score, pdr: model.pdr, cost: model.cost,
      x: costPlotX(model.cost), y: costPlotY(model.score),
    })).sort((a, b) => b.score - a.score),
  },
  ...scenarios.map((scenario, scenarioIndex) => ({
    id: scenario.id,
    label: scenario.label,
    detail: scenario.detail,
    rows: scenarioResults.map((model) => {
      const result = model.scenarios[scenarioIndex]!;
      return {
        name: model.name, maker: model.maker, icon: model.icon, color: model.color, badge: model.badge,
        score: result.score, pdr: result.pdr, cost: result.cost,
        x: costPlotX(result.cost), y: costPlotY(result.score),
      };
    }).sort((a, b) => b.score - a.score),
  })),
];

type DecisionPriority = 'overall' | 'design' | 'requirement' | 'speed' | 'cost';
/** 副卡展示的维度。primary 永远是当前关注指标本身。 */
type DecisionRole = 'overall' | 'design' | 'requirement' | 'cost' | 'speed';

/**
 * 两张副卡只展示"当前关注指标之外"的维度。
 * 否则选了「响应速度」时，副卡的响应速度卡必然比主卡更慢，标签会自相矛盾。
 */
const secondaryRolesFor = (priority: DecisionPriority): [DecisionRole, DecisionRole] =>
  priority === 'speed' ? ['overall', 'cost']
  : priority === 'cost' ? ['overall', 'speed']
  : ['cost', 'speed'];

const rolesFor = (priority: DecisionPriority): [DecisionRole, DecisionRole, DecisionRole] =>
  [priority as DecisionRole, ...secondaryRolesFor(priority)];
type DecisionRow = {
  name: string;
  maker: string;
  icon: string;
  color: string;
  badge?: string;
  score: number;
  pdr: number;
  d1: number;
  d2: number;
  cost: number;
  ttft: number;
  time: number;
};

const decisionRowsFor = (scenarioId: string): DecisionRow[] => scenarioResults.map((model) => {
  const result = scenarioId === 'overall' ? null : model.scenarios.find((item) => item.id === scenarioId);
  return {
    name: model.name,
    maker: model.maker,
    icon: model.icon,
    color: model.color,
    badge: model.badge,
    score: result?.score ?? model.score,
    pdr: result?.pdr ?? model.pdr,
    d1: result?.d1 ?? model.d1,
    d2: result?.d2 ?? model.d2,
    cost: result?.cost ?? model.cost,
    ttft: result?.ttft ?? model.ttft,
    time: result?.time ?? model.time,
  };
});

/** 成本从 $0.035 到 $7.66，低于 $1 时保留三位小数才看得出差别。 */
const formatCost = (cost: number) => (cost >= 1 ? cost.toFixed(2) : cost.toFixed(3));
/** 首次响应实测 20 – 365 秒，按整秒显示。 */
const formatSeconds = (seconds: number) => `${Math.round(seconds)}`;

const median = (values: number[]) => {
  const sorted = [...values].sort((a, b) => a - b);
  const middle = Math.floor(sorted.length / 2);
  return sorted.length % 2 ? sorted[middle]! : (sorted[middle - 1]! + sorted[middle]!) / 2;
};

/**
 * "可靠区" = 总分不低于本组中位数的模型。用相对门槛而不是写死的分数线，
 * 这样换一批模型或换一轮数据都不会把候选集清空。
 */
const reliableRows = (rows: DecisionRow[]) => {
  if (rows.length === 0) return rows;
  const cutoff = median(rows.map((row) => row.score));
  const above = rows.filter((row) => row.score >= cutoff);
  return above.length > 0 ? above : rows;
};

const recommendationsFor = (scenarioId: string, priority: DecisionPriority) => {
  const rows = decisionRowsFor(scenarioId);
  const reliable = reliableRows(rows);
  const rankedPrimary = [...(priority === 'cost' ? reliable.filter((row) => row.cost > 0) : rows)].sort((a, b) => {
    if (priority === 'design') return b.d2 - a.d2 || b.score - a.score;
    if (priority === 'requirement') return b.d1 - a.d1 || b.score - a.score;
    if (priority === 'speed') return a.ttft - b.ttft || b.score - a.score;
    if (priority === 'cost') return a.cost - b.cost || b.score - a.score;
    return b.score - a.score || b.pdr - a.pdr;
  });
  const primary = rankedPrimary[0] ?? rows[0]!;
  const picked = [primary];
  for (const role of secondaryRolesFor(priority)) {
    const pool = reliable.filter((row) => !picked.some((item) => item.name === row.name));
    const fallback = rows.filter((row) => !picked.some((item) => item.name === row.name));
    const candidates = pool.length ? pool : fallback;
    const sorted = [...candidates].sort((a, b) => {
      if (role === 'cost') return (b.score / Math.sqrt(Math.max(b.cost, 1e-6))) - (a.score / Math.sqrt(Math.max(a.cost, 1e-6)));
      if (role === 'speed') return a.ttft - b.ttft || b.score - a.score;
      return b.score - a.score || b.pdr - a.pdr;
    });
    if (sorted[0]) picked.push(sorted[0]);
  }
  return picked as [DecisionRow, DecisionRow, DecisionRow];
};

/** 理由只讲这张卡所代表的那个维度，避免和卡片标签说不同的事。 */
const decisionReason = (row: DecisionRow, role: DecisionRole) => {
  if (role === 'design') return isZh ? `D2 设计质量 ${row.d2.toFixed(1)}/70。` : `D2 design quality: ${row.d2.toFixed(1)}/70.`;
  if (role === 'requirement') return isZh ? `D1 需求完成度 ${row.d1.toFixed(1)}/30。` : `D1 requirement fulfillment: ${row.d1.toFixed(1)}/30.`;
  if (role === 'speed') return isZh ? `首次响应约 ${formatSeconds(row.ttft)} 秒。` : `About ${formatSeconds(row.ttft)}s to first output.`;
  if (role === 'cost') return isZh
    ? `总分 ${row.score.toFixed(1)} · 单份成本约 $${formatCost(row.cost)}。`
    : `Score ${row.score.toFixed(1)} · about $${formatCost(row.cost)} per run.`;
  return isZh
    ? `总分 ${row.score.toFixed(1)} · 可交付率 ${row.pdr.toFixed(1)}%。`
    : `Score ${row.score.toFixed(1)} · ${row.pdr.toFixed(1)}% delivery rate.`;
};

const initialRecommendations = recommendationsFor('overall', 'overall');
const initialRecommendationRoles = rolesFor('overall');

const lowerIsBetterPercentile = (value: number, values: number[]) => {
  const valid = values.filter((item) => item > 0).sort((a, b) => a - b);
  if (value <= 0 || valid.length < 2) return 50;
  const lower = valid.filter((item) => item < value).length;
  const equal = valid.filter((item) => item === value).length;
  const rank = lower + Math.max(0, equal - 1) / 2;
  return Number((100 * (1 - rank / (valid.length - 1))).toFixed(1));
};
const radarProfileFor = (row: DecisionRow, cohort: DecisionRow[]) => [
  Number((row.d1 / 30 * 100).toFixed(1)),
  Number((row.d2 / 70 * 100).toFixed(1)),
  lowerIsBetterPercentile(row.cost, cohort.map((item) => item.cost)),
  lowerIsBetterPercentile(row.time, cohort.map((item) => item.time)),
  lowerIsBetterPercentile(row.ttft, cohort.map((item) => item.ttft)),
];
const radarPointsFor = (values: number[]) => values.map((value, index) => {
  const angle = (-90 + index * 72) * Math.PI / 180;
  const distance = 78 * clamp(value, 0, 100) / 100;
  return `${(180 + Math.cos(angle) * distance).toFixed(1)},${(136 + Math.sin(angle) * distance).toFixed(1)}`;
}).join(' ');
const overallDecisionRows = decisionRowsFor('overall');
const initialRadarProfile = radarProfileFor(initialRecommendations[0], overallDecisionRows);
const initialRadarMedian = initialRadarProfile.map((_, index) => median(overallDecisionRows.map((row) => radarProfileFor(row, overallDecisionRows)[index]!)));
const initialRadarRaw = [
  `${initialRecommendations[0].d1.toFixed(1)}/30`,
  `${initialRecommendations[0].d2.toFixed(1)}/70`,
  initialRecommendations[0].cost > 0 ? `$${formatCost(initialRecommendations[0].cost)}` : decisionCopy.radar.unavailable,
  `${Math.round(initialRecommendations[0].time / 60)}min`,
  `${formatSeconds(initialRecommendations[0].ttft)}s`,
];
const radarGridLevels = [25, 50, 75, 100];
const radarOuterPoints = radarPointsFor([100, 100, 100, 100, 100]).split(' ').map((point) => point.split(','));
const radarLabelPositions = [
  { x: 180, y: 16, anchor: 'middle' },
  { x: 326, y: 86, anchor: 'end' },
  { x: 300, y: 250, anchor: 'end' },
  { x: 60, y: 250, anchor: 'start' },
  { x: 34, y: 86, anchor: 'start' },
];

// TTFT 实测 20 – 365 秒；总分实测 65.7 – 79.8。
const EFFICIENCY_TTFT_MAX = 400;
const efficiencyX = (model: Model) => Math.max(5, Math.min(95, 5 + (model.ttft / EFFICIENCY_TTFT_MAX) * 90));
const efficiencyY = (model: Model) => Math.max(6, Math.min(94, 6 + ((model.score - 60) / 25) * 88));

/**
 * 全维度总表。页面此前把总分、耗时、token、成本分散在三个区块里，
 * 读者要拼出一个模型的完整画像得来回跳；这张表让一行看完。
 */
const overviewRows = rankedModels.map((model) => ({
  ...model,
  scorePerDollar: model.cost > 0 ? model.score / model.cost : null,
}));
const overviewColumns = (isZh
  ? [
      ['name', '模型', 'text'], ['score', '总分', 'num'], ['pdr', '可交付率', 'num'],
      ['d1', 'D1 · 30', 'num'], ['d2', 'D2 · 70', 'num'], ['ttft', '首次响应', 'num'],
      ['time', '完成耗时', 'num'], ['tokens', 'Token', 'num'], ['price', '标价 入/出', 'text'],
      ['cost', '单份成本', 'num'], ['scorePerDollar', '分 / 美元', 'num'],
    ]
  : [
      ['name', 'Model', 'text'], ['score', 'Score', 'num'], ['pdr', 'Delivery', 'num'],
      ['d1', 'D1 · 30', 'num'], ['d2', 'D2 · 70', 'num'], ['ttft', 'First output', 'num'],
      ['time', 'Duration', 'num'], ['tokens', 'Tokens', 'num'], ['price', 'List in/out', 'text'],
      ['cost', 'Cost / run', 'num'], ['scorePerDollar', 'Score / $', 'num'],
    ]) as Array<[string, string, string]>;
const formatTokensStatic = (value: number) => value >= 1000000
  ? `${(value / 1000000).toFixed(1)}M`
  : `${Math.round(value / 1000)}K`;

const title = copy.title;
const description = copy.description;
const modelsJson = JSON.stringify(scenarioResults).replace(/</g, '\\u003c');
const scenariosJson = JSON.stringify(scenarios).replace(/</g, '\\u003c');
const clientCopyJson = JSON.stringify({
  percentage: copy.percentage,
  score: copy.score,
  scale: isZh ? '刻度' : 'scale',
  module: {
    ttft: { title: isZh ? '× 首次响应' : 'vs First response', xLabel: isZh ? 'TTFT（越左越快 →）' : 'TTFT (faster on the left →)' },
    duration: { title: isZh ? '× 完成耗时' : 'vs Completion time', xLabel: isZh ? '完成耗时（越左越快 →）' : 'Completion time (faster on the left →)' },
    cacheHit: { title: isZh ? '× 缓存命中率' : 'vs Cache hit rate', xLabel: isZh ? '缓存命中率（越右越高 →）' : 'Cache hit rate (higher on the right →)' },
    inputTokens: { title: isZh ? '× 输入 Token' : 'vs Input tokens', xLabel: isZh ? '输入 Token 数（越左越少 →）' : 'Input tokens (fewer on the left →)' },
    outputTokens: { title: isZh ? '× 输出 Token' : 'vs Output tokens', xLabel: isZh ? '输出 Token 数（越左越少 →）' : 'Output tokens (fewer on the left →)' },
  },
  scenario: isZh ? '场景' : 'scenario',
  allScenarios: isZh ? '综合' : 'Overall',
  quality: isZh ? '总分' : 'Score',
  pdr: isZh ? '可交付率' : 'Delivery rate',
  lowerBetter: copy.lowerBetter,
  higherBetter: isZh ? '越高越好' : 'higher is better',
  metricSummary: isZh ? { ttft: 'TTFT', duration: '耗时', cacheHit: '缓存', inputTokens: '输入', outputTokens: '输出' } : { ttft: 'TTFT', duration: 'Time', cacheHit: 'Cache', inputTokens: 'Input', outputTokens: 'Output' },
  guide: {
    roleLabels: decisionCopy.roleLabels,
    radar: decisionCopy.radar,
    reasons: isZh ? {
      overall: '总分 {score} · 可交付率 {pdr}%。',
      design: 'D2 设计质量 {metric}/70。',
      requirement: 'D1 需求完成度 {metric}/30。',
      speed: '首次响应约 {ttft} 秒。',
      cost: '总分 {score} · 单份成本约 ${cost}。',
    } : {
      overall: 'Score {score} · {pdr}% delivery rate.',
      design: 'D2 design quality: {metric}/70.',
      requirement: 'D1 requirement fulfillment: {metric}/30.',
      speed: 'About {ttft}s to first output.',
      cost: 'Score {score} · about ${cost} per run.',
    },
  },
}).replace(/</g, '\\u003c');
---

<Layout
  title={title}
  description={description}
  active="resources"
  mainClassName="model-index-main"
>
  <article class="model-index-page" data-model-index>
    <header class="model-index-intro">
      <h1>{copy.heading}</h1>
      <p>{copy.intro}</p>
      <ul class="model-findings">
        {(copy.findings as Array<[string, string]>).map(([headline, detail]) => (
          <li><b>{headline}</b><span>{detail}</span></li>
        ))}
      </ul>
      <div class="model-hero-actions">
        <a class="model-cta-btn model-cta-btn-primary" href={href(DOWNLOAD_HREF)}>
          {copy.ctaDownload}<span class="model-cta-btn-arrow" aria-hidden="true">→</span>
        </a>
        <a class="model-cta-btn" href={OPEN_DESIGN_DISCORD} target="_blank" rel="noopener">{copy.ctaDiscord}</a>
      </div>
    </header>

    <section class="model-section model-guide-section" aria-labelledby="quick-pick-title" data-model-guide>
      <div class="section-heading guide-heading">
        <div>
          <h2 id="quick-pick-title">{decisionCopy.heading}</h2>
          <p>{decisionCopy.description}</p>
        </div>
      </div>
      <div class="model-guide-shell">
        <div class="model-guide-controls">
          <div class="model-guide-control">
            <strong>{decisionCopy.scenarioLabel}</strong>
            <div role="group" aria-label={decisionCopy.scenarioLabel}>
              <button type="button" class="active" aria-pressed="true" data-guide-scenario="overall">{decisionCopy.overall}</button>
              {scenarios.map((scenario) => <button type="button" aria-pressed="false" data-guide-scenario={scenario.id}><i style={`background:${scenario.color}`}></i>{scenario.label}</button>)}
            </div>
          </div>
          <div class="model-guide-control">
            <strong>{decisionCopy.priorityLabel}</strong>
            <div role="group" aria-label={decisionCopy.priorityLabel}>
              {decisionCopy.priorities.map(([id, label], index) => <button type="button" class:list={{ active: index === 0 }} aria-pressed={index === 0 ? 'true' : 'false'} data-guide-priority={id}>{label}</button>)}
            </div>
          </div>
        </div>
        <div class="model-guide-results" aria-live="polite">
          {initialRecommendations.map((row, index) => {
            const role = initialRecommendationRoles[index]!;
            return (
              <article class:list={['model-recommendation', { 'is-primary': index === 0 }]} data-recommendation-card={index} style={`--recommendation-color:${row.color}`}>
                <div class="model-recommendation-topline"><span data-rec-role>{decisionCopy.roleLabels[initialRecommendationRoles[index]!]}</span></div>
                <header>
                  <span class="model-icon"><img data-rec-icon src={row.icon} alt="" width="32" height="32" /></span>
                  <h3 data-rec-name>{row.name}</h3>
                </header>
                <p data-rec-reason>{decisionReason(row, role)}</p>
                {index === 0 ? (
                  <div class="model-radar" data-model-radar>
                    <div class="model-radar-caption">
                      <div class="model-radar-legend" aria-hidden="true">
                        <span><i class="is-current"></i>{decisionCopy.radar.current}</span>
                        <span><i class="is-median"></i>{decisionCopy.radar.median}</span>
                      </div>
                    </div>
                    <svg viewBox="0 0 360 270" role="img" aria-label={decisionCopy.radar.aria}>
                      <g class="model-radar-grid" aria-hidden="true">
                        {radarGridLevels.map((level) => <polygon points={radarPointsFor([level, level, level, level, level])} />)}
                        {radarOuterPoints.map(([x, y]) => <line x1="180" y1="136" x2={x} y2={y} />)}
                      </g>
                      <polygon class="model-radar-median" data-radar-median points={radarPointsFor(initialRadarMedian)} />
                      <polygon class="model-radar-profile" data-radar-profile points={radarPointsFor(initialRadarProfile)} />
                      {initialRadarProfile.map((value, index) => {
                        const [x, y] = radarPointsFor([0, 0, 0, 0, 0].map((_, pointIndex) => pointIndex === index ? value : 0)).split(' ')[index]!.split(',');
                        return <circle class="model-radar-point" data-radar-point={index} cx={x} cy={y} r="3"><title>{decisionCopy.radar.axes[index]} · {initialRadarRaw[index]}</title></circle>;
                      })}
                      <g class="model-radar-labels">
                        {decisionCopy.radar.axes.map((axis, index) => (
                          <text x={radarLabelPositions[index]!.x} y={radarLabelPositions[index]!.y} text-anchor={radarLabelPositions[index]!.anchor} data-radar-axis={['requirement', 'design', 'cost', 'duration', 'speed'][index]}>
                            <tspan class="model-radar-axis-name">{axis}</tspan>
                            <tspan class="model-radar-axis-value" x={radarLabelPositions[index]!.x} dy="13" data-radar-value={index}>{initialRadarRaw[index]}</tspan>
                          </text>
                        ))}
                      </g>
                    </svg>
                  </div>
                ) : null}
                <dl>
                  <div><dt>{isZh ? '总分' : 'Score'}</dt><dd data-rec-score>{row.score.toFixed(1)}</dd></div>
                  <div><dt>{isZh ? '可交付率' : 'Delivery'}</dt><dd data-rec-pdr>{row.pdr.toFixed(1)}%</dd></div>
                  <div><dt>{isZh ? '单份成本' : 'Cost / run'}</dt><dd data-rec-cost>${formatCost(row.cost)}</dd></div>
                </dl>
              </article>
            );
          })}
        </div>
      </div>
    </section>

    <section class="model-section leaderboard-section" aria-labelledby="leaderboard-title">
      <div class="section-heading">
        <div>
          <h2 id="leaderboard-title">{copy.leaderboard}</h2>
          <p>{copy.leaderboardDesc}</p>
        </div>
      </div>

      <div class="leaderboard-insights" aria-label={isZh ? '综合榜关键指标' : 'Overall ranking highlights'}>
        {initialRecommendations.map((row, index) => (
          <div style={`--insight-color:${row.color}`}>
            <span>{decisionCopy.overallSignals[index]}</span>
            <strong><span class="model-icon"><img src={row.icon} alt="" width="24" height="24" /></span>{row.name}</strong>
            <small>{index === 0 ? `${row.pdr.toFixed(1)}% ${isZh ? '可交付' : 'delivered'}` : index === 1 ? `$${formatCost(row.cost)} / ${isZh ? '份' : 'run'}` : `${formatSeconds(row.ttft)}s ${isZh ? '首次响应' : 'to first output'}`}</small>
          </div>
        ))}
      </div>

      <div class="score-primer" aria-label={copy.scoreAria}>
        {copy.primer.map(([code, label], index) => index === copy.primer.length - 1 ? (
          <a href="#analysis-title"><strong>{code}</strong><small>{label}</small></a>
        ) : (
          <span><strong>{code}</strong><small>{label}</small></span>
        ))}
      </div>

      <div class="overview-table-wrap">
        <table class="overview-table" data-overview-table>
          <caption class="sr-only">{isZh ? '所有参评模型的效果、性能与成本' : 'Quality, performance and cost for every evaluated model'}</caption>
          <thead>
            <tr>
              {overviewColumns.map(([key, label, kind]) => (
                <th scope="col" class:list={[kind === 'num' ? 'is-num' : null]} data-sort-key={key} data-sort-kind={kind} aria-sort={key === 'score' ? 'descending' : 'none'}>
                  <button type="button">{label}<i aria-hidden="true"></i></button>
                </th>
              ))}
            </tr>
          </thead>
          <tbody>
            {overviewRows.map((row) => (
              <tr
                data-overview-row={row.name}
                data-score={row.score} data-pdr={row.pdr} data-d1={row.d1} data-d2={row.d2}
                data-ttft={row.ttft} data-time={row.time} data-tokens={row.inputTokens + row.outputTokens}
                data-cost={row.cost} data-score-per-dollar={row.scorePerDollar ?? 0}
              >
                <th scope="row"><span class="model-icon"><img src={row.icon} alt="" width="20" height="20" /></span><span><b>{row.name}</b><small>{row.maker}</small></span></th>
                <td class="is-num is-strong">{row.score.toFixed(1)}<i>±{row.ci95.toFixed(1)}</i></td>
                <td class="is-num">{row.pdr.toFixed(1)}%</td>
                <td class="is-num">{row.d1.toFixed(1)}</td>
                <td class="is-num">{row.d2.toFixed(1)}</td>
                <td class="is-num">{formatSeconds(row.ttft)}s</td>
                <td class="is-num">{Math.round(row.time / 60)}min</td>
                <td class="is-num">{formatTokensStatic(row.inputTokens + row.outputTokens)}</td>
                <td>${row.priceIn} / ${row.priceOut}</td>
                <td class="is-num">${formatCost(row.cost)}</td>
                <td class="is-num is-strong">{row.scorePerDollar ? Math.round(row.scorePerDollar).toLocaleString('en-US') : '—'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="overview-note">{isZh
        ? '标价为 2026-09-01 各家官网公开价（美元 / 百万 token）。单份成本 = 净输入 × 输入价 + 缓存命中 × 缓存读价 + 输出 × 输出价，逐条产物计算后取中位数。± 是总分均值的 95% 置信区间。'
        : 'List prices are public rates as of 2026-09-01 (USD per million tokens). Cost per run is uncached input at the input rate, cache hits at the cache-read rate, and output at the output rate, computed per artifact and taken as the median. The plus-minus figure is the 95% confidence interval of the mean score.'}</p>

      <ModelRankingPair group={leaderboardGroups[0]!} isZh={isZh} prominent />
    </section>

    <section class="model-section scenario-rankings-section" aria-labelledby="task-title">
      <div class="section-heading">
        <div><h2 id="task-title">{decisionCopy.scenarioHeading}</h2><p>{decisionCopy.scenarioDescription}</p></div>
      </div>
      <nav class="task-map" aria-label={isZh ? '五个设计场景' : 'Five design scenarios'}>
        {leaderboardGroups.slice(1).map((group, index) => {
          const scene = scenarios[index]!;
          const winner = group.rows[0]!;
          return (
            <a class="task-tile" href={`#scenario-${group.id}`} style={`background:${scene.color};grid-area:${scene.area}`}>
              <span>{group.label}</span><small>{group.detail}</small>
              <div class="task-winner">
                <span class="model-icon"><img src={winner.icon} alt="" width="24" height="24" /></span>
                <strong>{winner.name}</strong><b>{winner.score.toFixed(1)}<small>/100</small></b>
              </div>
            </a>
          );
        })}
      </nav>
      <div class="scenario-ranking-stack">
        {leaderboardGroups.slice(1).map((group, index) => {
          const scene = scenarios[index]!;
          const winner = group.rows[0]!;
          return (
            <article class="scenario-benchmark" id={`scenario-${group.id}`}>
              <header class="scenario-benchmark-head">
                <span>{String(index + 1).padStart(2, '0')}</span>
                <div><h3>{group.label}</h3><p>{group.detail}</p></div>
                <div class="scenario-verdict" style={`--scenario-color:${scene.color}`}>
                  <small>{decisionCopy.sceneChoice}</small>
                  <strong><span class="model-icon"><img src={winner.icon} alt="" width="24" height="24" /></span>{winner.name}</strong>
                  <p>{scene.fit}</p>
                  <dl><span>{winner.score.toFixed(1)} {isZh ? '分' : 'score'}</span><span>{winner.pdr.toFixed(1)}% {isZh ? '可交付' : 'delivered'}</span><span>${formatCost(winner.cost)} / {isZh ? '份' : 'run'}</span></dl>
                </div>
              </header>
              <ModelRankingPair group={group} isZh={isZh} />
            </article>
          );
        })}
      </div>
    </section>

    <section class="model-section analysis-section" aria-labelledby="analysis-title">
      <div class="section-heading">
        <div><h2 id="analysis-title">{copy.analysisHeading}</h2><p>{copy.analysisDesc}{isZh ? '效率与成本单独报告，不计入总分。' : ' Efficiency and cost are reported separately and do not affect the total score.'}</p></div>
      </div>
      <div class="analysis-explorer" data-analysis>
        <div class="analysis-toolbar">
          <div class="analysis-tabs" role="tablist" aria-label={copy.analysisAria}>
            <button type="button" role="tab" aria-selected="true" aria-controls="analysis-efficiency" class="active" data-analysis-view="ttft"><strong>{copy.ttft}</strong></button>
            <button type="button" role="tab" aria-selected="false" aria-controls="analysis-efficiency" data-analysis-view="duration"><strong>{copy.duration}</strong></button>
            <button type="button" role="tab" aria-selected="false" aria-controls="analysis-efficiency" data-analysis-view="cacheHit"><strong>{copy.cacheHit}</strong></button>
            <button type="button" role="tab" aria-selected="false" aria-controls="analysis-efficiency" data-analysis-view="inputTokens"><strong>{copy.inputTokens}</strong></button>
            <button type="button" role="tab" aria-selected="false" aria-controls="analysis-efficiency" data-analysis-view="outputTokens"><strong>{copy.outputTokens}</strong></button>
          </div>
          <div class="efficiency-quality-tabs" role="group" aria-label={isZh ? '纵轴分数' : 'Quality axis'}>
            <button type="button" class="active" aria-pressed="true" data-efficiency-quality="score">{isZh ? '总分' : 'Score'}</button>
            <button type="button" aria-pressed="false" data-efficiency-quality="pdr">{isZh ? '可交付率' : 'Delivery rate'}</button>
          </div>
        </div>
        <div class="efficiency-filter-bar">
          <div class="scenario-filter" role="group" aria-label={isZh ? '选择评测场景' : 'Select evaluation scene'}>
            <button type="button" class="active" aria-pressed="true" data-efficiency-scenario="overall">{isZh ? '综合' : 'Overall'}</button>
            {scenarios.map((scenario) => <button type="button" aria-pressed="false" data-efficiency-scenario={scenario.id}><i style={`background:${scenario.color}`}></i>{scenario.label}</button>)}
          </div>
          <div class="difficulty-control"><span>{copy.difficulty}</span><div class="difficulty-tabs" role="group" aria-label={copy.difficulty}><button type="button" aria-pressed="false" data-efficiency-difficulty="simple">{copy.simple}</button><button type="button" class="active" aria-pressed="true" data-efficiency-difficulty="general">{copy.general}</button><button type="button" aria-pressed="false" data-efficiency-difficulty="difficult">{copy.difficult}</button><i class="difficulty-indicator"></i></div></div>
        </div>

        <div id="analysis-efficiency" class="analysis-panel" role="tabpanel" data-analysis-panel="efficiency">
          <div class="efficiency-chart-shell">
            <div class="efficiency-chart-main">
              <div class="efficiency-chart-copy"><span data-efficiency-eyebrow>{isZh ? '综合 · 一般任务 · 数值越低越好' : 'Overall · General tasks · lower is better'}</span><h3 data-efficiency-title>{isZh ? '总分 × 首次响应' : 'Score vs First response'}</h3><p>{copy.chartDesc}</p></div>
              <div class="efficiency-chart-stage">
                <span class="efficiency-y-title" data-efficiency-y-label>{isZh ? '总分（越高越好 ↑）' : 'Score (higher ↑)'}</span><span class="efficiency-x-title" data-efficiency-x-label>{isZh ? 'TTFT（越左越快 →）' : 'TTFT (faster on the left →)'}</span>
                <div class="efficiency-y-ticks" aria-hidden="true" data-efficiency-y-ticks><span>85</span><span>78</span><span>72</span><span>65</span></div>
                <div class="efficiency-x-ticks" aria-hidden="true"><span>0s</span><span>100s</span><span>200s</span><span>300s</span><span>400s</span></div>
                <div class="efficiency-plot">
                  <div class="efficiency-ideal-zone"><span>{isZh ? '高分 · 高效率' : 'High score · High efficiency'}</span></div>
                  <svg class="efficiency-frontier" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true"><polyline points=""></polyline></svg>
                  {scenarioResults.map((model, index) => (
                    <div class:list={['efficiency-point', { 'is-highlighted': index < 4 }]} data-efficiency-point={model.name} style={`left:${efficiencyX(model)}%;bottom:${efficiencyY(model)}%;--point-color:${model.color}`}>
                      <span class="model-icon"><img src={model.icon} alt="" width="28" height="28" /></span>
                      <span class="efficiency-point-name">{model.name}</span>
                      <span class="efficiency-point-label"><strong>{model.name}</strong><small>TTFT {model.ttft}s · {isZh ? '耗时' : 'Time'} {model.time}s<br />{isZh ? '缓存' : 'Cache'} {model.cacheHit}% · {isZh ? '输入' : 'Input'} {(model.inputTokens / 1000).toFixed(1)}K · {isZh ? '输出' : 'Output'} {(model.outputTokens / 1000).toFixed(1)}K</small></span>
                    </div>
                  ))}
                </div>
              </div>
            </div>
            <aside class="efficiency-model-index">
              <div class="model-index-heading"><span>{copy.models}</span><strong data-model-count>{models.length}</strong></div>
              <div class="efficiency-model-list">
                {models.map((model) => (
                  <div class="efficiency-model-row" data-efficiency-row={model.name}>
                    <span class="model-icon"><img src={model.icon} alt="" width="28" height="28" /></span>
                    <span><strong>{model.name}{model.badge ? <em class="model-badge">{model.badge}</em> : null}</strong><small>{model.maker}</small></span><b>{model.ttft}s</b>
                  </div>
                ))}
              </div>
            </aside>
          </div>
        </div>
      </div>
    </section>

    <section class="model-section compare-section" aria-labelledby="compare-title">
      <div class="section-heading"><div><h2 id="compare-title">{isZh ? '模型对比' : 'Compare models'}</h2><p>{isZh ? '选择二到三个模型，把综合分、三项核心指标与五场景表现放在同一视图中比较。' : 'Select two or three models to compare overall results, core metrics, and all five scenes.'}</p></div></div>
      <div class="compare-picker" role="group" aria-label={isZh ? '选择对比模型' : 'Select models to compare'}>
        {scenarioResults.map((model, index) => <button type="button" class:list={{ active: index < 3 }} aria-pressed={index < 3 ? 'true' : 'false'} data-compare-model={model.name}><span class="model-icon"><img src={model.icon} alt="" width="22" height="22" /></span>{model.name}</button>)}
      </div>
      <div class="compare-grid" data-compare-grid></div>
    </section>

    {excludedModels.length > 0 && (
      <section class="model-section excluded-section" aria-labelledby="excluded-title">
        <div class="section-heading">
          <div>
            <h2 id="excluded-title">{isZh ? '本轮未纳入排名' : 'Not ranked this round'}</h2>
            <p>{isZh
              ? '这些模型跑完了全部任务，但执行过程本身出了问题，成绩不能代表模型能力，因此不参与排序。数据一并公开。'
              : 'These models completed every task, but the run itself hit problems, so the result does not reflect model capability and is left out of the ranking. The data is published anyway.'}</p>
          </div>
        </div>
        <ul class="excluded-list">
          {excludedModels.map((model) => (
            <li>
              <div class="excluded-model">
                <span class="model-icon"><img src={model.icon} alt="" width="24" height="24" /></span>
                <span><strong>{model.name}</strong><small>{model.maker}</small></span>
              </div>
              <dl class="excluded-metrics">
                <div><dt>{isZh ? '总分' : 'Score'}</dt><dd>{model.score.toFixed(1)}</dd></div>
                <div><dt>{isZh ? '可渲染率' : 'Renderability'}</dt><dd>{model.d0.toFixed(1)}%</dd></div>
                <div><dt>{isZh ? '产物' : 'Artifacts'}</dt><dd>{model.n}</dd></div>
              </dl>
              <p>{model.excludedReason?.[isZh ? 'zh' : 'en']}</p>
            </li>
          ))}
        </ul>
      </section>
    )}

    <section class="model-section method-section" aria-labelledby="method-title">
      <div class="section-heading"><div><h2 id="method-title">{copy.methodHeading}</h2><p>{copy.methodDesc}</p></div></div>
      <div class="method-overview">
        <div class="method-primary"><span>{copy.primaryMetric}</span><div><strong>{isZh ? '总分' : 'Score'}</strong><h3>{copy.pdrName}</h3></div><p>{copy.pdrDesc}</p></div>
        <ol class="method-flow" aria-label={copy.flowAria}>
          {copy.flow.map(([title, detail]) => <li><span><strong>{title}</strong><small>{detail}</small></span></li>)}
        </ol>
      </div>
      <div class="method-table">
        {methodCards.map(([code, badge, heading, body, bullets]) => (
          <article><header><span>{code}</span><em>{badge}</em></header><h3>{heading}</h3><p>{body}</p><ul>{bullets.map((bullet) => <li>{bullet}</li>)}</ul></article>
        ))}
      </div>
      <div class="method-disclosure">
        {copy.disclosures.map(([heading, body]) => <div><strong>{heading}</strong><p>{body}</p></div>)}
      </div>
    </section>

    <aside class="ranking-strip">
      <p>{copy.stripLead}</p>
      <a href={href(DOWNLOAD_HREF)}>{copy.stripCta}<span aria-hidden="true"> →</span></a>
    </aside>
  </article>
  <script is:inline type="application/json" id="model-rankings-data" set:html={modelsJson}></script>
  <script is:inline type="application/json" id="model-rankings-scenarios" set:html={scenariosJson}></script>
  <script is:inline type="application/json" id="model-rankings-copy" set:html={clientCopyJson}></script>
  <script>
    type EfficiencyModule = 'ttft' | 'duration' | 'cacheHit' | 'inputTokens' | 'outputTokens';
    type Difficulty = 'simple' | 'general' | 'difficult';
    type QualityMetric = 'score' | 'pdr';
    type ScenarioId = 'overall' | string;
    type GuidePriority = 'overall' | 'design' | 'requirement' | 'speed' | 'cost';
    type ScenarioResult = { id: string; n: number; ci95: number | null; d1: number; d2: number; score: number; pdr: number; ttft: number; time: number; cacheHit: number; inputTokens: number; outputTokens: number; cost: number; calls: number };
    type DifficultySlice = Omit<ScenarioResult, 'id'>;
    type ClientModel = {
      name: string;
      maker: string;
      icon: string;
      color: string;
      badge?: string;
      score: number;
      pdr: number;
      d0: number;
      d1: number;
      d2: number;
      ttft: number;
      time: number;
      cacheHit: number;
      inputTokens: number;
      outputTokens: number;
      cost: number;
      calls: number;
      scenarios: ScenarioResult[];
      difficulty: Record<'simple' | 'general' | 'hard', DifficultySlice>;
    };
    type ClientScenario = { id: string; label: string; fit: string; color: string };
    type ClientCopy = {
      percentage: string;
      score: string;
      scale: string;
      module: Record<EfficiencyModule, { title: string; xLabel: string; suffix?: string }>;
      scenario: string;
      allScenarios: string;
      quality: string;
      pdr: string;
      lowerBetter: string;
      higherBetter: string;
      metricSummary: Record<EfficiencyModule, string>;
      guide: {
        roleLabels: Record<string, string>;
        radar: { aria: string; current: string; median: string; unavailable: string; axes: string[] };
        reasons: Record<'value' | 'faster' | GuidePriority, string>;
      };
    };

    const root = document.querySelector<HTMLElement>('[data-model-index]');
    const dataElement = document.querySelector<HTMLScriptElement>('#model-rankings-data');
    const scenariosElement = document.querySelector<HTMLScriptElement>('#model-rankings-scenarios');
    const copyElement = document.querySelector<HTMLScriptElement>('#model-rankings-copy');
    if (root && dataElement && scenariosElement && copyElement) {
      const modelData = JSON.parse(dataElement.textContent || '[]') as ClientModel[];
      const scenarioData = JSON.parse(scenariosElement.textContent || '[]') as ClientScenario[];
      const clientCopy = JSON.parse(copyElement.textContent || '{}') as ClientCopy;

      let activeGuideScenario = 'overall';
      let activeGuidePriority: GuidePriority = 'overall';
      /** 与构建期 formatCost / formatSeconds 保持一致，否则 hydration 后数字会变。 */
      const fmtCost = (cost: number) => (cost >= 1 ? cost.toFixed(2) : cost.toFixed(3));
      const fmtSeconds = (seconds: number) => `${Math.round(seconds)}`;

      // 总表排序：数值列按 data-* 上的原始数字排，避免解析 "23min" 这类展示文本。
      const overviewTable = root.querySelector<HTMLTableElement>('[data-overview-table]');
      if (overviewTable) {
        const body = overviewTable.tBodies[0]!;
        const headers = [...overviewTable.querySelectorAll<HTMLTableCellElement>('thead th')];
        const sortValue = (row: HTMLTableRowElement, key: string, kind: string) => kind === 'num'
          ? Number(row.dataset[key === 'scorePerDollar' ? 'scorePerDollar' : key] ?? 0)
          : (row.dataset.overviewRow || '');
        headers.forEach((header) => {
          const key = header.dataset.sortKey!;
          const kind = header.dataset.sortKind!;
          if (key === 'price') return;
          header.querySelector('button')?.addEventListener('click', () => {
            // 数值列默认从高到低，名称列从 A 到 Z；再次点击反向。
            const current = header.getAttribute('aria-sort');
            const next = current === 'descending' ? 'ascending'
              : current === 'ascending' ? 'descending'
              : kind === 'num' ? 'descending' : 'ascending';
            headers.forEach((other) => other.setAttribute('aria-sort', 'none'));
            header.setAttribute('aria-sort', next);
            const rows = [...body.rows].sort((a, b) => {
              const av = sortValue(a, key, kind);
              const bv = sortValue(b, key, kind);
              const cmp = kind === 'num' ? (av as number) - (bv as number) : String(av).localeCompare(String(bv));
              return next === 'ascending' ? cmp : -cmp;
            });
            rows.forEach((row) => body.append(row));
          });
        });
      }

      const guideRowsFor = (scenarioId: string) => modelData.map((model) => {
        const result = scenarioId === 'overall' ? null : model.scenarios.find((item) => item.id === scenarioId);
        return {
          ...model,
          score: result?.score ?? model.score,
          pdr: result?.pdr ?? model.pdr,
          d1: result?.d1 ?? model.d1,
          d2: result?.d2 ?? model.d2,
          cost: result?.cost ?? model.cost,
          ttft: result?.ttft ?? model.ttft,
          time: result?.time ?? model.time,
        };
      });
      const guideMedian = (values: number[]) => {
        const sorted = [...values].sort((a, b) => a - b);
        const middle = Math.floor(sorted.length / 2);
        return sorted.length % 2 ? sorted[middle]! : (sorted[middle - 1]! + sorted[middle]!) / 2;
      };
      const guideLowerIsBetter = (value: number, values: number[]) => {
        const valid = values.filter((item) => item > 0).sort((a, b) => a - b);
        if (value <= 0 || valid.length < 2) return 50;
        const lower = valid.filter((item) => item < value).length;
        const equal = valid.filter((item) => item === value).length;
        const rank = lower + Math.max(0, equal - 1) / 2;
        return 100 * (1 - rank / (valid.length - 1));
      };
      const guideRadarProfile = (row: ReturnType<typeof guideRowsFor>[number], cohort: ReturnType<typeof guideRowsFor>) => [
        row.d1 / 30 * 100,
        row.d2 / 70 * 100,
        guideLowerIsBetter(row.cost, cohort.map((item) => item.cost)),
        guideLowerIsBetter(row.time, cohort.map((item) => item.time)),
        guideLowerIsBetter(row.ttft, cohort.map((item) => item.ttft)),
      ];
      const guideRadarPoints = (values: number[]) => values.map((value, index) => {
        const angle = (-90 + index * 72) * Math.PI / 180;
        const distance = 78 * Math.max(0, Math.min(100, value)) / 100;
        return `${(180 + Math.cos(angle) * distance).toFixed(1)},${(136 + Math.sin(angle) * distance).toFixed(1)}`;
      }).join(' ');
      const guideRadarRaw = (row: ReturnType<typeof guideRowsFor>[number]) => [
        `${row.d1.toFixed(1)}/30`,
        `${row.d2.toFixed(1)}/70`,
        row.cost > 0 ? `$${fmtCost(row.cost)}` : clientCopy.guide.radar.unavailable,
        `${Math.round(row.time / 60)}min`,
        `${Math.round(row.ttft)}s`,
      ];
      const updateGuideRadar = (row: ReturnType<typeof guideRowsFor>[number], cohort: ReturnType<typeof guideRowsFor>) => {
        const radar = root.querySelector<HTMLElement>('[data-model-radar]');
        if (!radar) return;
        const profile = guideRadarProfile(row, cohort);
        const cohortProfiles = cohort.map((item) => guideRadarProfile(item, cohort));
        const medianProfile = profile.map((_, index) => guideMedian(cohortProfiles.map((values) => values[index]!)));
        const rawValues = guideRadarRaw(row);
        radar.classList.add('is-updating');
        radar.querySelector<SVGPolygonElement>('[data-radar-profile]')?.setAttribute('points', guideRadarPoints(profile));
        radar.querySelector<SVGPolygonElement>('[data-radar-median]')?.setAttribute('points', guideRadarPoints(medianProfile));
        profile.forEach((value, index) => {
          const [x, y] = guideRadarPoints(profile.map((item, pointIndex) => pointIndex === index ? item : 0)).split(' ')[index]!.split(',');
          const point = radar.querySelector<SVGCircleElement>(`[data-radar-point="${index}"]`);
          point?.setAttribute('cx', x!);
          point?.setAttribute('cy', y!);
          const title = point?.querySelector('title');
          if (title) title.textContent = `${clientCopy.guide.radar.axes[index]} · ${rawValues[index]}`;
          const valueLabel = radar.querySelector<SVGTextElement>(`[data-radar-value="${index}"]`);
          if (valueLabel) valueLabel.textContent = rawValues[index]!;
        });
        const highlightedAxis = activeGuidePriority === 'requirement' ? 'requirement'
          : activeGuidePriority === 'design' ? 'design'
          : activeGuidePriority === 'cost' ? 'cost'
          : activeGuidePriority === 'speed' ? 'speed'
          : '';
        radar.querySelectorAll<SVGTextElement>('[data-radar-axis]').forEach((axis) => axis.classList.toggle('is-highlighted', axis.dataset.radarAxis === highlightedAxis));
        requestAnimationFrame(() => radar.classList.remove('is-updating'));
      };
      type GuideRole = 'overall' | 'design' | 'requirement' | 'cost' | 'speed';
      /** 与构建期 secondaryRolesFor 同一套规则，避免 hydration 后角色变了。 */
      const guideSecondaryRoles = (priority: GuidePriority): GuideRole[] =>
        priority === 'speed' ? ['overall', 'cost']
        : priority === 'cost' ? ['overall', 'speed']
        : ['cost', 'speed'];
      const guideRoles = (priority: GuidePriority): GuideRole[] => [priority as GuideRole, ...guideSecondaryRoles(priority)];

      const guideRecommendations = (scenarioId: string, priority: GuidePriority) => {
        const rows = guideRowsFor(scenarioId);
        // 与构建期的 reliableRows 保持同一口径：总分不低于本组中位数。
        const scoreCutoff = guideMedian(rows.map((row) => row.score));
        const aboveCutoff = rows.filter((row) => row.score >= scoreCutoff);
        const reliable = aboveCutoff.length > 0 ? aboveCutoff : rows;
        const primaryPool = priority === 'cost' ? reliable.filter((row) => row.cost > 0) : rows;
        const primary = [...primaryPool].sort((a, b) => {
          if (priority === 'design') return b.d2 - a.d2 || b.score - a.score;
          if (priority === 'requirement') return b.d1 - a.d1 || b.score - a.score;
          if (priority === 'speed') return a.ttft - b.ttft || b.score - a.score;
          if (priority === 'cost') return a.cost - b.cost || b.score - a.score;
          return b.score - a.score || b.pdr - a.pdr;
        })[0] || rows[0]!;
        const picked = [primary];
        for (const role of guideSecondaryRoles(priority)) {
          const pool = reliable.filter((row) => !picked.some((item) => item.name === row.name));
          const fallback = rows.filter((row) => !picked.some((item) => item.name === row.name));
          const candidates = pool.length ? pool : fallback;
          const sorted = [...candidates].sort((a, b) => {
            if (role === 'cost') return (b.score / Math.sqrt(Math.max(b.cost, 1e-6))) - (a.score / Math.sqrt(Math.max(a.cost, 1e-6)));
            if (role === 'speed') return a.ttft - b.ttft || b.score - a.score;
            return b.score - a.score || b.pdr - a.pdr;
          });
          if (sorted[0]) picked.push(sorted[0]);
        }
        return picked;
      };
      const guideReason = (row: ReturnType<typeof guideRowsFor>[number], role: GuideRole) => {
        const metric = role === 'design' ? row.d2 : row.d1;
        return clientCopy.guide.reasons[role]
          .replace('{pdr}', row.pdr.toFixed(1))
          .replace('{score}', row.score.toFixed(1))
          .replace('{cost}', fmtCost(row.cost))
          .replace('{ttft}', fmtSeconds(row.ttft))
          .replace('{metric}', metric.toFixed(1));
      };
      const renderGuide = () => {
        const roles = guideRoles(activeGuidePriority);
        const cohort = guideRowsFor(activeGuideScenario);
        guideRecommendations(activeGuideScenario, activeGuidePriority).forEach((row, index) => {
          const card = root.querySelector<HTMLElement>(`[data-recommendation-card="${index}"]`);
          if (!card) return;
          card.style.setProperty('--recommendation-color', row.color);
          const icon = card.querySelector<HTMLImageElement>('[data-rec-icon]');
          const name = card.querySelector<HTMLElement>('[data-rec-name]');
          const role = card.querySelector<HTMLElement>('[data-rec-role]');
          const reason = card.querySelector<HTMLElement>('[data-rec-reason]');
          const score = card.querySelector<HTMLElement>('[data-rec-score]');
          const pdr = card.querySelector<HTMLElement>('[data-rec-pdr]');
          const cost = card.querySelector<HTMLElement>('[data-rec-cost]');
          if (icon) icon.src = row.icon;
          if (name) name.textContent = row.name;
          if (role) role.textContent = clientCopy.guide.roleLabels[roles[index]!] || '';
          if (reason) reason.textContent = guideReason(row, roles[index]!);
          if (score) score.textContent = row.score.toFixed(1);
          if (pdr) pdr.textContent = `${row.pdr.toFixed(1)}%`;
          if (cost) cost.textContent = `$${fmtCost(row.cost)}`;
          if (index === 0) updateGuideRadar(row, cohort);
        });
      };
      root.querySelectorAll<HTMLButtonElement>('[data-guide-scenario]').forEach((button) => button.addEventListener('click', () => {
        activeGuideScenario = button.dataset.guideScenario || 'overall';
        root.querySelectorAll<HTMLButtonElement>('[data-guide-scenario]').forEach((item) => {
          const selected = item === button;
          item.classList.toggle('active', selected);
          item.setAttribute('aria-pressed', String(selected));
        });
        renderGuide();
      }));
      root.querySelectorAll<HTMLButtonElement>('[data-guide-priority]').forEach((button) => button.addEventListener('click', () => {
        activeGuidePriority = (button.dataset.guidePriority || 'overall') as GuidePriority;
        root.querySelectorAll<HTMLButtonElement>('[data-guide-priority]').forEach((item) => {
          const selected = item === button;
          item.classList.toggle('active', selected);
          item.setAttribute('aria-pressed', String(selected));
        });
        renderGuide();
      }));

      root.querySelectorAll<HTMLElement>('[data-ranking-card]').forEach((card) => {
        const list = card.querySelector<HTMLElement>('.ranking-list');
        const label = card.querySelector<HTMLElement>('[data-ranking-value-label]');
        const buttons = [...card.querySelectorAll<HTMLButtonElement>('[data-ranking-view]')];
        const render = (view: 'score' | 'percentage') => {
          const rows = [...card.querySelectorAll<HTMLElement>('[data-ranking-row]')].sort((a, b) => Number(b.dataset[view] || 0) - Number(a.dataset[view] || 0));
          rows.forEach((row, index) => {
            const value = Number(row.dataset[view] || 0);
            const height = Math.max(12, Math.min(84, (value - 50) * 1.7));
            const position = row.querySelector<HTMLElement>('[data-ranking-position]');
            const valueNode = row.querySelector<HTMLElement>('.ranking-value');
            if (position) position.textContent = String(index + 1);
            row.style.setProperty('--model-value', String(value));
            row.style.setProperty('--model-height', `${height}%`);
            if (valueNode) valueNode.innerHTML = view === 'percentage' ? `<strong>${value.toFixed(1)}%</strong><small></small>` : `<strong>${value.toFixed(1)}</strong><small>/100</small>`;
            list?.append(row);
          });
          if (label) label.textContent = view === 'percentage' ? clientCopy.percentage : clientCopy.score;
          buttons.forEach((button) => {
            const selected = button.dataset.rankingView === view;
            button.classList.toggle('active', selected);
            button.setAttribute('aria-selected', String(selected));
          });
        };
        buttons.forEach((button) => button.addEventListener('click', () => render(button.dataset.rankingView as 'score' | 'percentage')));
        render('score');
      });

      // 常驻标签的方向：构建期只能按百分比估算，误差够大到会撞。
      // 这里用真实几何重算一次，按名次依次放，每个都避开其它模型的点和已放好的标签。
      const overlap = (a: DOMRect, b: DOMRect) => a.right > b.left && a.left < b.right && a.bottom > b.top && a.top < b.bottom;
      root.querySelectorAll<HTMLElement>('.cost-plot').forEach((plot) => {
        const points = [...plot.querySelectorAll<HTMLElement>('.cost-point')];
        const placed: DOMRect[] = [];
        points.filter((point) => point.classList.contains('is-labeled')).forEach((point) => {
          const label = point.querySelector<HTMLElement>('.cost-point-label');
          if (!label) return;
          const bounds = plot.getBoundingClientRect();
          let best: { dir: string; cost: number } | null = null;
          for (const dir of ['up', 'down', 'up-right', 'up-left', 'down-right', 'down-left', 'right', 'left']) {
            point.dataset.labelDir = dir;
            const rect = label.getBoundingClientRect();
            let cost = rect.left < bounds.left - 62 || rect.right > bounds.right + 62 || rect.top < bounds.top - 32 || rect.bottom > bounds.bottom + 32 ? 3 : 0;
            points.forEach((other) => { if (other !== point && overlap(rect, other.getBoundingClientRect())) cost += 1; });
            placed.forEach((rows) => { if (overlap(rect, rows)) cost += 2; });
            if (!best || cost < best.cost) best = { dir, cost };
            if (cost === 0) break;
          }
          // 放不下就不放：第 1 名保底常驻，2、3 名只在能干净落位时才常驻，
          // 否则退回 hover 显示 —— 密集的图里宁可少两个标签，也不要压字。
          if (best!.cost > 0 && placed.length > 0) {
            point.classList.remove('is-labeled');
            delete point.dataset.labelDir;
            return;
          }
          point.dataset.labelDir = best!.dir;
          placed.push(label.getBoundingClientRect());
        });
      });

      const formatTokens = (value: number) => {
        if (value <= 0) return '0';
        if (value >= 1000000) return `${(value / 1000000).toFixed(value >= 10000000 ? 0 : 1)}M`;
        return `${(value / 1000).toFixed(value >= 10000 ? 0 : 1)}K`;
      };
      const moduleConfig = {
        ttft: { label: clientCopy.module.ttft.title, xLabel: clientCopy.module.ttft.xLabel, maximum: 400, ticks: [0, 100, 200, 300, 400], higherBetter: false, format: (value: number) => `${Math.round(value)}s` },
        duration: { label: clientCopy.module.duration.title, xLabel: clientCopy.module.duration.xLabel, maximum: 2100, ticks: [0, 525, 1050, 1575, 2100], higherBetter: false, format: (value: number) => `${Math.round(value / 60)}min` },
        cacheHit: { label: clientCopy.module.cacheHit.title, xLabel: clientCopy.module.cacheHit.xLabel, maximum: 100, ticks: [0, 25, 50, 75, 100], higherBetter: true, format: (value: number) => `${value.toFixed(1)}%` },
        inputTokens: { label: clientCopy.module.inputTokens.title, xLabel: clientCopy.module.inputTokens.xLabel, maximum: 2000000, ticks: [0, 500000, 1000000, 1500000, 2000000], higherBetter: false, format: formatTokens },
        outputTokens: { label: clientCopy.module.outputTokens.title, xLabel: clientCopy.module.outputTokens.xLabel, maximum: 140000, ticks: [0, 35000, 70000, 105000, 140000], higherBetter: false, format: formatTokens },
      } satisfies Record<EfficiencyModule, { label: string; xLabel: string; maximum: number; ticks: number[]; higherBetter: boolean; format: (value: number) => string }>;
      const isZhClient = document.documentElement.lang.startsWith('zh');
      const difficultyConfig: Record<Difficulty, { key: 'simple' | 'general' | 'hard'; label: string }> = {
        simple: { key: 'simple', label: isZhClient ? '简单任务' : 'Simple tasks' },
        general: { key: 'general', label: isZhClient ? '一般任务' : 'General tasks' },
        difficult: { key: 'hard', label: isZhClient ? '困难任务' : 'Difficult tasks' },
      };
      let activeModule: EfficiencyModule = 'ttft';
      let activeScenario: ScenarioId = 'overall';
      let activeQuality: QualityMetric = 'score';
      let activeDifficulty: Difficulty = 'general';

      /**
       * 场景和难度是数据集的两个正交切分（5 场景 × 3 难度 = 15 道题），
       * 每个切片都有实测值，不做任何推导。两者同时选中时以场景为准，
       * 因为交叉后每格只剩 2 个产物。
       */
      const resultFor = (model: ClientModel) => {
        if (activeScenario !== 'overall') return model.scenarios.find((result) => result.id === activeScenario) || model;
        if (activeDifficulty !== 'general') return model.difficulty[difficultyConfig[activeDifficulty].key] || model;
        return model;
      };
      const qualityFor = (model: ClientModel) => {
        const result = resultFor(model) as ClientModel | ScenarioResult;
        return activeQuality === 'pdr' ? result.pdr : result.score;
      };
      const valueFor = (model: ClientModel, module: EfficiencyModule = activeModule) => {
        const result = resultFor(model) as ClientModel | ScenarioResult;
        if (module === 'ttft') return result.ttft;
        if (module === 'duration') return result.time;
        if (module === 'cacheHit') return result.cacheHit;
        if (module === 'inputTokens') return result.inputTokens;
        return result.outputTokens;
      };
      /**
       * 效率图的点位会随指标 / 场景 / 难度实时变化，所以标签方向只能在运行时算。
       * 规则与成本图一致（8 个方向 + 两轮局部修复），区别是这里直接量真实
       * 渲染尺寸，不用估算公式。
       */
      const EFF_DIRECTIONS = ['right', 'left', 'up', 'down', 'up-right', 'up-left', 'down-right', 'down-left'];
      type EffBox = { x0: number; x1: number; y0: number; y1: number };
      const effOverlaps = (a: EffBox, b: EffBox) => a.x1 > b.x0 && a.x0 < b.x1 && a.y1 > b.y0 && a.y0 < b.y1;
      const placeEfficiencyLabels = (points: Array<{ model: ClientModel; x: number; y: number }>) => {
        const plot = root.querySelector<HTMLElement>('.efficiency-plot');
        if (!plot) return;
        const plotRect = plot.getBoundingClientRect();
        if (!plotRect.width || !plotRect.height) return;
        const items = points.map(({ model, x, y }) => {
          const point = root.querySelector<HTMLElement>(`[data-efficiency-point="${CSS.escape(model.name)}"]`);
          const name = point?.querySelector<HTMLElement>('.efficiency-point-name');
          const nameRect = name?.getBoundingClientRect();
          const pointRect = point?.getBoundingClientRect();
          const radiusX = ((pointRect?.width ?? 28) / 2 + 5) / plotRect.width * 100;
          const radiusY = ((pointRect?.height ?? 28) / 2 + 5) / plotRect.height * 100;
          return {
            point, x, y, radiusX, radiusY,
            w: (nameRect?.width ?? 60) / plotRect.width * 100,
            h: (nameRect?.height ?? 12) / plotRect.height * 100,
          };
        }).filter((item) => item.point);
        const rect = (item: typeof items[number], dir: string): EffBox => {
          const half = item.h / 2;
          switch (dir) {
            case 'up': return { x0: item.x - item.w / 2, x1: item.x + item.w / 2, y0: item.y + item.radiusY, y1: item.y + item.radiusY + item.h };
            case 'down': return { x0: item.x - item.w / 2, x1: item.x + item.w / 2, y0: item.y - item.radiusY - item.h, y1: item.y - item.radiusY };
            case 'left': return { x0: item.x - item.radiusX - item.w, x1: item.x - item.radiusX, y0: item.y - half, y1: item.y + half };
            case 'right': return { x0: item.x + item.radiusX, x1: item.x + item.radiusX + item.w, y0: item.y - half, y1: item.y + half };
            case 'up-left': return { x0: item.x - item.radiusX - item.w, x1: item.x - item.radiusX, y0: item.y + item.radiusY - half, y1: item.y + item.radiusY + half };
            case 'up-right': return { x0: item.x + item.radiusX, x1: item.x + item.radiusX + item.w, y0: item.y + item.radiusY - half, y1: item.y + item.radiusY + half };
            case 'down-left': return { x0: item.x - item.radiusX - item.w, x1: item.x - item.radiusX, y0: item.y - item.radiusY - half, y1: item.y - item.radiusY + half };
            default: return { x0: item.x + item.radiusX, x1: item.x + item.radiusX + item.w, y0: item.y - item.radiusY - half, y1: item.y - item.radiusY + half };
          }
        };
        const boxes = new Map<number, EffBox>();
        const choose = (item: typeof items[number], index: number) => EFF_DIRECTIONS
          .map((dir) => {
            const box = rect(item, dir);
            const outside = box.x0 < -2 || box.x1 > 102 || box.y0 < -2 || box.y1 > 102 ? 1 : 0;
            // 文字压文字最不可读，权重最高；压住别的圆点次之。
            const hits = items.filter((other, otherIndex) => otherIndex !== index
              && other.x + other.radiusX > box.x0 && other.x - other.radiusX < box.x1
              && other.y + other.radiusY > box.y0 && other.y - other.radiusY < box.y1).length;
            const clashes = [...boxes.entries()].filter(([key, placed]) => key !== index && effOverlaps(box, placed)).length;
            return { dir, box, cost: clashes * 12 + hits * 2 + outside * 8 };
          })
          .reduce((winner, candidate) => (candidate.cost < winner.cost ? candidate : winner));
        items.forEach((item, index) => {
          const best = choose(item, index);
          boxes.set(index, best.box);
          item.point!.dataset.labelDir = best.dir;
        });
        for (let pass = 0; pass < 2; pass += 1) {
          items.forEach((item, index) => {
            const best = choose(item, index);
            boxes.set(index, best.box);
            item.point!.dataset.labelDir = best.dir;
          });
        }
      };

      const renderEfficiency = () => {
        const config = moduleConfig[activeModule];
        const scene = activeScenario === 'overall' ? clientCopy.allScenarios : scenarioData.find((item) => item.id === activeScenario)?.label || activeScenario;
        const qualityLabel = activeQuality === 'score' ? clientCopy.quality : clientCopy.pdr;
        const eyebrow = root.querySelector<HTMLElement>('[data-efficiency-eyebrow]');
        const titleNode = root.querySelector<HTMLElement>('[data-efficiency-title]');
        const yLabel = root.querySelector<HTMLElement>('[data-efficiency-y-label]');
        const xLabel = root.querySelector<HTMLElement>('[data-efficiency-x-label]');
        const xTicks = root.querySelector<HTMLElement>('.efficiency-x-ticks');
        const yTicks = root.querySelector<HTMLElement>('[data-efficiency-y-ticks]');
        if (eyebrow) eyebrow.textContent = `${scene} · ${difficultyConfig[activeDifficulty].label} · ${config.higherBetter ? clientCopy.higherBetter : clientCopy.lowerBetter}`;
        if (titleNode) titleNode.textContent = `${qualityLabel} ${config.label}`;
        if (yLabel) yLabel.textContent = `${qualityLabel}（${activeQuality === 'pdr' ? '%' : '/100'}）`;
        if (xLabel) xLabel.textContent = config.xLabel;
        if (xTicks) xTicks.innerHTML = config.ticks.map((tick) => `<span>${config.format(tick)}</span>`).join('');
        if (yTicks) yTicks.innerHTML = (activeQuality === 'pdr' ? [75, 60, 45, 30] : [85, 78, 72, 65]).map((tick) => `<span>${tick}</span>`).join('');
        const plot = root.querySelector<HTMLElement>('.efficiency-plot');
        plot?.classList.toggle('is-higher-better', config.higherBetter);
        const points = modelData.map((model) => {
          const value = valueFor(model);
          const quality = qualityFor(model);
          return { model, value, quality, x: Math.max(5, Math.min(95, 5 + value / config.maximum * 90)), y: Math.max(6, Math.min(94, 6 + (quality - (activeQuality === 'pdr' ? 25 : 60)) / (activeQuality === 'pdr' ? 55 : 25) * 88)) };
        });
        points.forEach(({ model, value, x, y }) => {
          const point = root.querySelector<HTMLElement>(`[data-efficiency-point="${CSS.escape(model.name)}"]`);
          const row = root.querySelector<HTMLElement>(`[data-efficiency-row="${CSS.escape(model.name)}"]`);
          if (point) {
            point.style.left = `${x}%`;
            point.style.bottom = `${y}%`;
            const label = point.querySelector<HTMLElement>('small');
            if (label) label.innerHTML = `${clientCopy.metricSummary.ttft} ${moduleConfig.ttft.format(valueFor(model, 'ttft'))} · ${clientCopy.metricSummary.duration} ${moduleConfig.duration.format(valueFor(model, 'duration'))}<br>${clientCopy.metricSummary.cacheHit} ${moduleConfig.cacheHit.format(valueFor(model, 'cacheHit'))} · ${clientCopy.metricSummary.inputTokens} ${moduleConfig.inputTokens.format(valueFor(model, 'inputTokens'))} · ${clientCopy.metricSummary.outputTokens} ${moduleConfig.outputTokens.format(valueFor(model, 'outputTokens'))}`;
          }
          const rowValue = row?.querySelector<HTMLElement>('b');
          if (rowValue) rowValue.textContent = config.format(value);
        });
        placeEfficiencyLabels(points);
        const ranked = [...points].sort((a, b) => config.higherBetter ? b.value - a.value : a.value - b.value);
        const list = root.querySelector<HTMLElement>('.efficiency-model-list');
        ranked.forEach(({ model }, index) => {
          const point = root.querySelector<HTMLElement>(`[data-efficiency-point="${CSS.escape(model.name)}"]`);
          point?.classList.toggle('is-highlighted', index < 4);
          const row = root.querySelector<HTMLElement>(`[data-efficiency-row="${CSS.escape(model.name)}"]`);
          if (row) list?.append(row);
        });
        let best = -Infinity;
        const frontier = ranked.filter((point) => {
          if (point.quality <= best) return false;
          best = point.quality;
          return true;
        });
        const polyline = root.querySelector<SVGPolylineElement>('.efficiency-frontier polyline');
        if (polyline) polyline.setAttribute('points', frontier.map((point) => `${point.x},${100 - point.y}`).join(' '));
      };

      root.querySelectorAll<HTMLButtonElement>('[data-analysis-view]').forEach((button) => button.addEventListener('click', () => {
        activeModule = button.dataset.analysisView as EfficiencyModule;
        root.querySelectorAll<HTMLButtonElement>('[data-analysis-view]').forEach((item) => {
          const selected = item === button;
          item.classList.toggle('active', selected);
          item.setAttribute('aria-selected', String(selected));
        });
        renderEfficiency();
      }));
      root.querySelectorAll<HTMLButtonElement>('[data-efficiency-scenario]').forEach((button) => button.addEventListener('click', () => {
        activeScenario = button.dataset.efficiencyScenario || 'overall';
        root.querySelectorAll<HTMLButtonElement>('[data-efficiency-scenario]').forEach((item) => {
          const selected = item === button;
          item.classList.toggle('active', selected);
          item.setAttribute('aria-pressed', String(selected));
        });
        renderEfficiency();
      }));
      root.querySelectorAll<HTMLButtonElement>('[data-efficiency-quality]').forEach((button) => button.addEventListener('click', () => {
        activeQuality = button.dataset.efficiencyQuality as QualityMetric;
        root.querySelectorAll<HTMLButtonElement>('[data-efficiency-quality]').forEach((item) => {
          const selected = item === button;
          item.classList.toggle('active', selected);
          item.setAttribute('aria-pressed', String(selected));
        });
        renderEfficiency();
      }));
      root.querySelectorAll<HTMLButtonElement>('[data-efficiency-difficulty]').forEach((button, index) => button.addEventListener('click', () => {
        activeDifficulty = button.dataset.efficiencyDifficulty as Difficulty;
        root.querySelectorAll<HTMLButtonElement>('[data-efficiency-difficulty]').forEach((item) => {
          const selected = item === button;
          item.classList.toggle('active', selected);
          item.setAttribute('aria-pressed', String(selected));
        });
        const indicator = root.querySelector<HTMLElement>('.difficulty-indicator');
        indicator?.style.setProperty('--indicator-x', `${index * 100}%`);
        renderEfficiency();
      }));

      let comparedModels = modelData.slice(0, 3).map((model) => model.name);
      const renderCompare = () => {
        const grid = root.querySelector<HTMLElement>('[data-compare-grid]');
        if (!grid) return;
        grid.innerHTML = comparedModels.map((name) => {
          const model = modelData.find((item) => item.name === name)!;
          const sceneRows = model.scenarios.map((result) => {
            const scenario = scenarioData.find((item) => item.id === result.id)!;
            return `<div><span><i style="background:${scenario.color}"></i>${scenario.label}</span><b>${result.score.toFixed(1)}</b></div>`;
          }).join('');
          return `<article class="compare-card" style="--compare-color:${model.color}">
            <header><span class="model-icon"><img src="${model.icon}" alt="" width="28" height="28"></span><span><strong>${model.name}${model.badge ? `<em class="model-badge">${model.badge}</em>` : ''}</strong><small>${model.maker}</small></span></header>
            <div class="compare-headline"><span>${clientCopy.pdr} <strong>${model.pdr.toFixed(1)}%</strong></span><span>${clientCopy.quality} <strong>${model.score.toFixed(1)}</strong></span></div>
            <div class="compare-metrics"><div><small>D1</small><strong>${model.d1.toFixed(1)}<i>/30</i></strong></div><div><small>D2</small><strong>${model.d2.toFixed(1)}<i>/70</i></strong></div><div><small>Speed</small><strong>${Math.round(model.time / 60)}min</strong></div><div><small>Cost</small><strong>$${fmtCost(model.cost)}</strong></div><div><small>Calls</small><strong>${model.calls.toFixed(1)}</strong></div></div>
            <div class="compare-scenes">${sceneRows}</div>
          </article>`;
        }).join('');
        root.querySelectorAll<HTMLButtonElement>('[data-compare-model]').forEach((button) => {
          const selected = comparedModels.includes(button.dataset.compareModel || '');
          button.classList.toggle('active', selected);
          button.setAttribute('aria-pressed', String(selected));
        });
      };
      root.querySelectorAll<HTMLButtonElement>('[data-compare-model]').forEach((button) => button.addEventListener('click', () => {
        const name = button.dataset.compareModel || '';
        if (comparedModels.includes(name)) {
          if (comparedModels.length > 2) comparedModels = comparedModels.filter((item) => item !== name);
        } else if (comparedModels.length < 3) {
          comparedModels = [...comparedModels, name];
        } else {
          comparedModels = [...comparedModels.slice(1), name];
        }
        renderCompare();
      }));

      renderGuide();
      renderEfficiency();
      renderCompare();
    }
  </script>
</Layout>
