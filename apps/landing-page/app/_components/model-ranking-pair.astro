---
type RankingRow = {
  name: string;
  maker: string;
  icon: string;
  color: string;
  badge?: string;
  score: number;
  pdr: number;
  cost: number;
  x: number;
  y: number;
};

type RankingGroup = {
  id: string;
  label: string;
  detail: string;
  rows: RankingRow[];
};

interface Props {
  group: RankingGroup;
  isZh: boolean;
  prominent?: boolean;
}

const { group, isZh, prominent = false } = Astro.props;
/** 成本从 $0.035 到 $7.66，低于 $1 时保留三位小数才看得出差别。 */
const formatCost = (cost: number) => (cost >= 1 ? cost.toFixed(2) : cost.toFixed(3));
const scoreLabel = isZh ? '总分' : 'Score';
const deliveryLabel = isZh ? '可交付率' : 'Delivery rate';
const scoreAxisLabel = isZh ? '总分' : 'Total score';
const modelLabel = isZh ? '模型' : 'Model';
// 场景名可能以拉丁字母结尾（Dashboard、Web 端 App），中西文之间要留空格
const zhGap = /[A-Za-z0-9)\]]$/.test(group.label) ? ' ' : '';
const rankingTitle = isZh ? `${group.label}${zhGap}排名` : `${group.label} ranking`;
const costTitle = isZh ? `${group.label}${zhGap}· 总分 × 成本` : `${group.label} · score vs cost`;
const costDescription = isZh ? '左上象限代表用更低成本拿到更高的总分。横轴是对数刻度，实测成本跨度超过 200 倍。' : 'The upper-left quadrant reaches a higher score at a lower cost. The x-axis is logarithmic — measured cost spans more than 200x.';
// 实测总分区间 65.7 – 79.8，用 58 – 85 作画布。
const chartHeight = (value: number) => Math.max(12, Math.min(84, (value - 58) * 3.4));

// 高效区边界按本组真实数据推导，而不是写死象限：
// 锚点 = PDR 第一梯队（前半）里成本最低的模型，区域刚好把它包进来。
// 写死 52%/50% 时锚点会卡在边界外，绿区看起来永远没人达标。
const byScore = [...group.rows].sort((a, b) => b.score - a.score);
const topTier = byScore.slice(0, Math.ceil(byScore.length / 2));
const zoneAnchor = topTier.reduce((best, row) => (row.cost < best.cost ? row : best), topTier[0]!);
// 边界给锚点留固定余量，让它确实落在区域内部而不是压在拐角上。
// 中点规则会被"成本只高一点点"的模型挤到紧贴锚点；跟着一起进区的模型
// 本来也是高性价比的那几个，读法不受影响。
const zoneWidth = Math.min(96, zoneAnchor.x + 8);
const zoneHeight = Math.min(96, 100 - (zoneAnchor.y - 8));

// 常驻标签的方向在构建期算：重点模型沿成本-PDR 对角链排布，写死方向必然撞上相邻图标。
// 用绘图区百分比估算标签占位，四个方向里挑与其它点重叠最少的那个。
const LABEL_W = 34;   // 标签宽约占绘图区宽的 34%
const LABEL_H = 11;   // 标签高约占绘图区高的 11%
const GAP_X = 7;      // 图标半径 + 间距，换算成 x 百分比
const GAP_Y = 6;      // 同上，y 百分比
const DOT_X = 5;      // 重点图标半宽
const DOT_Y = 4;      // 重点图标半高
const labelRect = (row: RankingRow, dir: string) => {
  if (dir === 'up') return { x0: row.x - LABEL_W / 2, x1: row.x + LABEL_W / 2, y0: row.y + GAP_Y, y1: row.y + GAP_Y + LABEL_H };
  if (dir === 'down') return { x0: row.x - LABEL_W / 2, x1: row.x + LABEL_W / 2, y0: row.y - GAP_Y - LABEL_H, y1: row.y - GAP_Y };
  if (dir === 'left') return { x0: row.x - GAP_X - LABEL_W, x1: row.x - GAP_X, y0: row.y - LABEL_H / 2, y1: row.y + LABEL_H / 2 };
  return { x0: row.x + GAP_X, x1: row.x + GAP_X + LABEL_W, y0: row.y - LABEL_H / 2, y1: row.y + LABEL_H / 2 };
};
// 依次放置：后放的标签要同时避开其它模型的图标和已放好的标签，
// 否则三个标签会各自独立地都选「上」然后互相压住。
const overlaps = (a: { x0: number; x1: number; y0: number; y1: number }, b: { x0: number; x1: number; y0: number; y1: number }) =>
  a.x1 > b.x0 && a.x0 < b.x1 && a.y1 > b.y0 && a.y0 < b.y1;
const placedLabels: Array<{ x0: number; x1: number; y0: number; y1: number }> = [];
const labelDirs = new Map<string, string>();
group.rows.slice(0, 3).forEach((row) => {
  const others = group.rows.filter((other) => other !== row);
  const scored = ['up', 'down', 'right', 'left'].map((dir) => {
    const box = labelRect(row, dir);
    const outside = box.x0 < -6 || box.x1 > 106 || box.y0 < -4 || box.y1 > 104 ? 1 : 0;
    const hits = others.filter((other) =>
      other.x + DOT_X > box.x0 && other.x - DOT_X < box.x1 && other.y + DOT_Y > box.y0 && other.y - DOT_Y < box.y1).length;
    const clashes = placedLabels.filter((placed) => overlaps(box, placed)).length;
    return { dir, box, cost: hits + clashes * 2 + outside * 3 };
  });
  const best = scored.reduce((winner, item) => (item.cost < winner.cost ? item : winner), scored[0]!);
  placedLabels.push(best.box);
  labelDirs.set(row.name, best.dir);
});

---

<div class:list={['ranking-pair', { 'ranking-pair-prominent': prominent }]}>
  <section class="ranking-card" data-ranking-card data-scenario={group.id} aria-label={rankingTitle}>
    <header class="benchmark-card-head">
      <div>
        <h3>{rankingTitle}</h3>
      </div>
      <div class="ranking-card-controls">
        <span class="model-count">{group.rows.length} {isZh ? '个模型' : 'models'}</span>
        <div class="ranking-view-tabs" role="tablist" aria-label={isZh ? `${group.label}排名数值` : `${group.label} ranking value`}>
          <button type="button" class="active" role="tab" aria-selected="true" data-ranking-view="score">{scoreLabel}</button>
          <button type="button" role="tab" aria-selected="false" data-ranking-view="percentage">{deliveryLabel}</button>
        </div>
      </div>
    </header>
    <div class="ranking-chart">
      <div class="ranking-chart-scroll">
        <div class="ranking-list" aria-label={modelLabel}>
          {group.rows.map((model, index) => (
            <div
              class="ranking-row"
              data-ranking-row={model.name}
              data-score={model.score}
              data-percentage={model.pdr}
              style={`--model-color:${model.color};--model-value:${model.score};--model-height:${chartHeight(model.score)}%`}
            >
              <span class="ranking-track">
                <span class="ranking-fill">
                  <span class="ranking-value"><strong>{model.score.toFixed(1)}</strong><small>/100</small></span>
                  <span class="model-icon"><img src={model.icon} alt="" width="28" height="28" /></span>
                </span>
              </span>
              <span class="ranking-model">
                <i data-ranking-position>{index + 1}</i>
                <span><strong>{model.name}{model.badge ? <em class="model-badge">{model.badge}</em> : null}</strong><small>{model.maker}</small></span>
              </span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="cost-card" aria-label={`${group.label} ${costTitle}`}>
    <header class="benchmark-card-head cost-card-head">
      <div><h3>{costTitle}</h3><p>{costDescription}</p></div>
    </header>
    <div class="cost-stage">
      <span class="cost-y-label">{scoreAxisLabel} ({isZh ? '越高越好' : 'higher is better'})</span>
      <span class="cost-x-label">{isZh ? '单份产物成本（越低越好，对数刻度）' : 'Cost per artifact (lower is better, log scale)'}</span>
      <div class="cost-y-ticks" aria-hidden="true"><span>85</span><span>78</span><span>72</span><span>65</span></div>
      <div class="cost-x-ticks" aria-hidden="true"><span>$0.02</span><span>$0.10</span><span>$0.50</span><span>$2</span><span>$10</span></div>
      <div class="cost-plot">
        <div class="cost-ideal-zone" style={`--zone-w:${zoneWidth}%;--zone-h:${zoneHeight}%`}><span>{isZh ? '高总分 / 低成本' : 'High score / low cost'}</span></div>
        {group.rows.map((model, index) => (
          <span
            class:list={['cost-point', { 'is-leading': index < 4, 'is-labeled': index < 3, 'is-winner': index === 0 }]}
            data-label-dir={labelDirs.get(model.name)}
            style={`--x:${model.x}%;--y:${model.y}%;--point-color:${model.color}`}
            aria-label={`${model.name}: ${isZh ? '总分' : 'score'} ${model.score.toFixed(1)}, $${formatCost(model.cost)}`}
            tabindex="0"
          >
            {index < 4 ? <span class="model-icon"><img src={model.icon} alt="" width="26" height="26" /></span> : null}
            <span class="cost-point-label"><strong>{model.name}</strong><small>{model.score.toFixed(1)} / ${formatCost(model.cost)}</small></span>
          </span>
        ))}
      </div>
    </div>
  </section>
</div>
