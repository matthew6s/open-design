{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexu.io/contracts/terminal/shell-updater-v1.schema.json",
  "title": "Shell updater snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "revision", "shellType", "state", "actions", "blockedBy"],
  "properties": {
    "schemaVersion": {"const": 1},
    "revision": {"type": "integer", "minimum": 0},
    "shellType": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
    "state": {"enum": ["idle", "checking", "available", "downloading", "ready", "applying", "handed-off", "failed"]},
    "progress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["completed", "total"],
      "properties": {"completed": {"type": "integer", "minimum": 0}, "total": {"type": "integer", "minimum": 1}}
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "emphasis"],
        "properties": {
          "id": {"enum": ["check", "download", "install", "later", "force-stop-and-install"]},
          "emphasis": {"enum": ["primary", "secondary", "danger"]}
        }
      }
    },
    "blockedBy": {"type": "array"},
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {"code": {"type": "string"}, "message": {"type": "string"}}
    }
  }
}
